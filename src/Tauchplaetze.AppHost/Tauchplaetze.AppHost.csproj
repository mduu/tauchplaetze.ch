<Project Sdk="Aspire.AppHost.Sdk/13.6.1">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Dashboard und DCP kommen als NuGet-Packages. So läuft «dotnet run» ohne die Aspire CLI. -->
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
    <UserSecretsId>7d0f3a52-3c4e-4b8a-9a43-1f0f2b8f9d11</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.SqlServer" />
    <PackageReference Include="Aspire.Hosting.Azure.Storage" />
    <PackageReference Include="MessagePack" />
    <!-- Transitiv über die Projekte. 10.0.12 hat bekannte Lücken (siehe Directory.Packages.props). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Tauchplaetze.Web/Tauchplaetze.Web.csproj" />
    <ProjectReference Include="../spikes/Tauchplaetze.Spike.DataSources/Tauchplaetze.Spike.DataSources.csproj" />
  </ItemGroup>
</Project>
