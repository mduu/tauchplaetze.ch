@using Tauchplaetze.Core.Features.Accounts
@using Tauchplaetze.Web.Features.Accounts
@inject IStringLocalizer<AccountStrings> L
@inject IStringLocalizer<AdminStrings> Admin
@inject IStringLocalizer<DiveSiteStrings> Site

@* Die Einträge des Kontos als Listenpunkte: im Kontomenü und im Menü für schmale Bildschirme. *@
<AuthorizeView>
    <Authorized>
        <li><a href="@AccountPaths.Profile(Language)">@L["Profile_Title"]</a></li>
        <li><a href="@AccountPaths.Proposals(Language)">@Admin["Nav_MyProposals"]</a></li>
        <li><a href="@PublicRoutes.NewDiveSite(Language)" data-enhance-nav="false">@Site["NewSite_Link"]</a></li>
        @if (context.User.IsInRole(Roles.Moderator) || context.User.IsInRole(Roles.Admin))
        {
            <li><a href="/admin" data-enhance-nav="false">@Admin["Nav_Moderation"]</a></li>
        }
        @if (context.User.IsInRole(Roles.Admin))
        {
            <li><a href="/platform" data-enhance-nav="false">@Admin["Nav_Platform"]</a></li>
        }
        <li>
            <form method="post" action="@AccountPaths.SignOut(Language)">
                <AntiforgeryToken />
                <button type="submit">@L["Nav_SignOut"]</button>
            </form>
        </li>
    </Authorized>
    <NotAuthorized>
        @if (WithSignIn)
        {
            <li><a href="@AccountPaths.SignIn(Language)">@L["Nav_SignIn"]</a></li>
        }
    </NotAuthorized>
</AuthorizeView>

@code {
    /// <summary>Ohne Anmeldung den Eintrag «Anmelden» zeigen. Das Kontomenü zeigt ihn als eigenen Link.</summary>
    [Parameter]
    public bool WithSignIn { get; set; }

    private static string Language => CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
}
