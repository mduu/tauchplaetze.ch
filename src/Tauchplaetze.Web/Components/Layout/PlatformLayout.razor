@inherits LayoutComponentBase
@using MudBlazor
@inject IStringLocalizer<AdminStrings> L

<MudThemeProvider Theme="AdminTheme.Dark" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<PageTitle>@L["Nav_Platform"] · tauchplaetze.ch</PageTitle>

<MudLayout>
    <MudAppBar Elevation="0" Dense="true" Class="platform-bar">
        <AdminBrand Area="@L["Nav_Platform"]" />
        <nav class="platform-nav" aria-label="@L["Nav_Platform"]">
            <NavLink class="platform-link" href="/platform" Match="NavLinkMatch.All">@L["Nav_Dashboard"]</NavLink>
            <NavLink class="platform-link" href="/platform/konten">@L["Nav_Accounts"]</NavLink>
            <NavLink class="platform-link" href="/platform/prognose">@L["Nav_Forecast"]</NavLink>
            <NavLink class="platform-link" href="/platform/queues">@L["Platform_Queues_Title"]</NavLink>
            <NavLink class="platform-link" href="/platform/inhalt">@L["Platform_Content_Title"]</NavLink>
        </nav>
        <MudSpacer />
        <MudLink Href="/admin" Target="_top" Color="Color.Inherit" Underline="Underline.None" Class="mr-4">@L["Nav_Moderation"]</MudLink>
        <MudLink Href="@($"/{Language}")" Target="_top" Color="Color.Inherit" Underline="Underline.None">@L["Nav_Public"]</MudLink>
    </MudAppBar>
    <MudMainContent Class="admin-main">
        <MudContainer MaxWidth="MaxWidth.Large" Class="py-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private static string Language => CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
}
