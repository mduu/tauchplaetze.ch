@inherits LayoutComponentBase
@inject IStringLocalizer<SharedStrings> L

<a class="skip-link" href="#main">@L["SkipToContent"]</a>

<header class="site-header">
    <a class="brand" href="/@CurrentLanguage" aria-label="@L["Brand_Home"]">
        <picture>
            <source srcset="@Assets["img/logo-128.webp"]" type="image/webp" />
            <img class="brand-mark" src="@Assets["img/logo-128.png"]" width="62" height="64" alt="" />
        </picture>
        <span class="brand-name">@L["Brand"]</span>
    </a>
    <div class="nav-slot">
        <MainNav />
    </div>
    <div class="header-tools">
        <UserMenu />
        <LanguageSwitch />
    </div>
</header>

<main id="main">
    @Body
</main>

<footer class="site-footer">
    <div class="footer-inner">
        <p>@L["Footer_Note"]</p>
        <p>@L["Footer_Emergency"]</p>
        <p><a href="https://www.openstreetmap.org/copyright" rel="noopener">@L["Footer_Osm"]</a></p>
        <nav class="footer-links" aria-label="@L["Footer_Links"]">
            <a href="@PublicRoutes.AboutPage(CurrentLanguage)">@L["Footer_About"]</a>
            <a href="@PublicRoutes.AboutPage(CurrentLanguage, "impressum")">@L["Footer_Imprint"]</a>
            <a href="@PublicRoutes.AboutPage(CurrentLanguage, "datenschutz")">@L["Footer_Privacy"]</a>
        </nav>
    </div>
</footer>

@code {
    private static string CurrentLanguage => CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
}
