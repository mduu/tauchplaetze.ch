@inherits LayoutComponentBase
@inject IStringLocalizer<SharedStrings> L

<a class="skip-link" href="#main">@L["SkipToContent"]</a>

<header class="site-header">
    <a class="brand" href="/@CurrentLanguage" aria-label="@L["Brand_Home"]">
        <picture>
            <source srcset="@Assets["img/logo-88.webp"]" type="image/webp" />
            <img class="brand-mark" src="@Assets["img/logo-88.png"]" width="43" height="44" alt="" />
        </picture>
        <span class="brand-name">@L["Brand"]</span>
    </a>
    <LanguageSwitch />
</header>

<main id="main">
    @Body
</main>

<footer class="site-footer">
    <div class="footer-inner">
        <p>@L["Footer_Note"]</p>
        <p>@L["Footer_Emergency"]</p>
    </div>
</footer>

@code {
    private static string CurrentLanguage => CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
}
