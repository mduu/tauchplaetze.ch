@inherits LayoutComponentBase
@using Microsoft.Extensions.Caching.Memory
@using Tauchplaetze.Core.CrossCutting.UseCases
@using Tauchplaetze.Core.Features.Echolot
@using Tauchplaetze.Core.Features.Echolot.Queries
@inject IStringLocalizer<SharedStrings> L
@inject NavigationManager Navigation
@inject IServiceScopeFactory Scopes
@inject IMemoryCache Cache
@inject ILogger<PublicLayout> Logger

<a class="skip-link" href="@MainAnchor">@L["SkipToContent"]</a>

<header class="site-header">
    <a class="brand" href="/@CurrentLanguage" aria-label="@L["Brand_Home"]">
        <picture>
            <source srcset="@Assets["img/logo-128.webp"]" type="image/webp" />
            <img class="brand-mark" src="@Assets["img/logo-128.png"]" width="62" height="64" alt="" />
        </picture>
        <span class="brand-name">@L["Brand"]</span>
    </a>
    <div class="nav-slot">
        <MainNav />
    </div>
    <div class="header-tools">
        <div class="tools-wide">
            <InfoMenu Health="health" />
            <UserMenu />
            <LanguageSwitch />
        </div>
        <div class="tools-narrow">
            <SiteMenu Health="health" />
        </div>
    </div>
</header>

<main id="main">
    @Body
</main>

<footer class="site-footer">
    <div class="footer-inner">
        <p>@L["Footer_Note"]</p>
        <p>@L["Footer_Emergency"]</p>
        <p><a href="https://www.openstreetmap.org/copyright" rel="noopener">@L["Footer_Osm"]</a></p>
        <nav class="footer-links" aria-label="@L["Footer_Links"]">
            <a href="@PublicRoutes.AboutPage(CurrentLanguage)">@L["Footer_About"]</a>
            <a href="@PublicRoutes.EcholotPage(CurrentLanguage)">@L["Footer_Echolot"]</a>
            <a href="@PublicRoutes.AboutPage(CurrentLanguage, "impressum")">@L["Footer_Imprint"]</a>
            <a href="@PublicRoutes.AboutPage(CurrentLanguage, "datenschutz")">@L["Footer_Privacy"]</a>
        </nav>
    </div>
</footer>

@code {
    /// <summary>So lange gilt der Gesamtzustand im Speicher. Er ändert sich mit den Jobs, höchstens alle 30 Minuten.</summary>
    private static readonly TimeSpan HealthCacheFor = TimeSpan.FromMinutes(5);

    private DataHealth health = DataHealth.Unknown;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            health = await Cache.GetOrCreateAsync(nameof(GetDataHealthQuery), async entry =>
            {
                entry.AbsoluteExpirationRelativeToNow = HealthCacheFor;
                return await LoadHealth();
            });
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogWarning(ex, "Overall data health unavailable, the info menu shows no status");
        }
    }

    /// <remarks>
    /// Layout und Seite rendern gleichzeitig. Ein eigener Scope gibt der Query einen eigenen DbContext,
    /// sonst greifen beide parallel auf denselben zu. Ohne Zustand fehlt nur die Zeile im Info-Menü.
    /// </remarks>
    private async Task<DataHealth> LoadHealth()
    {
        await using var scope = Scopes.CreateAsyncScope();
        return await scope.ServiceProvider.GetRequiredService<IQueryHandler<GetDataHealthQuery, DataHealth>>().Handle(new GetDataHealthQuery());
    }

    /// <summary>Mit Pfad, weil `&lt;base href="/"&gt;` einen reinen Anker gegen die Startseite auflöst.</summary>
    private string MainAnchor => "/" + Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0] + "#main";

    private static string CurrentLanguage => CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
}
