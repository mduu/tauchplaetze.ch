@inherits LayoutComponentBase
@inject IStringLocalizer<SharedStrings> L

<a class="skip-link" href="#main">@L["SkipToContent"]</a>

<header class="site-header">
    <a class="brand" href="/@CurrentLanguage" aria-label="@L["Brand_Home"]">
        <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true">
            <circle cx="16" cy="16" r="15" fill="none" stroke="currentColor" stroke-width="2" />
            <path d="M6 18c3-3 6-3 10 0s7 3 10 0" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
            <circle cx="21" cy="10" r="2.5" fill="var(--color-signal)" />
        </svg>
        <span class="brand-name">@L["Brand"]</span>
    </a>
    <LanguageSwitch />
</header>

<main id="main" class="site-main">
    @Body
</main>

<footer class="site-footer">
    <p>@L["Footer_NeverDiveAlone"] @L["Footer_Indicator"]</p>
</footer>

@code {
    private static string CurrentLanguage => CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
}
