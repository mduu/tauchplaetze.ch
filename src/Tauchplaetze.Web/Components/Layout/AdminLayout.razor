@inherits LayoutComponentBase
@using MudBlazor
@using Tauchplaetze.Core.Features.Accounts
@inject IStringLocalizer<AdminStrings> L

<MudThemeProvider Theme="AdminTheme.Dark" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<PageTitle>@L["Title"] · tauchplaetze.ch</PageTitle>

<MudLayout>
    <MudAppBar Elevation="0" Dense="true">
        <MudText Typo="Typo.h6" Class="admin-brand">tauchplaetze.ch · @L["Title"]</MudText>
        <MudSpacer />
        <AuthorizeView>
            <MudText Typo="Typo.body2" Class="mr-4">@context.User.Identity?.Name</MudText>
        </AuthorizeView>
        <MudLink Href="@($"/{Language}")" Color="Color.Inherit" Underline="Underline.None">@L["Nav_Public"]</MudLink>
    </MudAppBar>
    <MudDrawer Open="true" ClipMode="DrawerClipMode.Always" Elevation="0" Variant="DrawerVariant.Mini" OpenMiniOnHover="false">
        <MudNavMenu>
            <MudNavLink Href="/admin" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.Dashboard">@L["Nav_Dashboard"]</MudNavLink>
            <MudNavLink Href="/admin/plaetze" Icon="@Icons.Material.Outlined.Place">@L["Nav_Sites"]</MudNavLink>
            <AuthorizeView Roles="@($"{Roles.Moderator},{Roles.Admin}")">
                <MudNavLink Href="/admin/vorschlaege" Icon="@Icons.Material.Outlined.FactCheck">@L["Nav_Pending"]</MudNavLink>
                <MudNavLink Href="/admin/prognose" Icon="@Icons.Material.Outlined.WaterDrop">@L["Nav_Forecast"]</MudNavLink>
                <MudNavLink Href="/admin/konten" Icon="@Icons.Material.Outlined.People">@L["Nav_Accounts"]</MudNavLink>
            </AuthorizeView>
        </MudNavMenu>
    </MudDrawer>
    <MudMainContent Class="admin-main">
        <MudContainer MaxWidth="MaxWidth.Large" Class="py-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private static string Language => CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
}
