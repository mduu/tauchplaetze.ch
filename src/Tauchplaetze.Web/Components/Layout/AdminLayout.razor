@inherits LayoutComponentBase
@implements IDisposable
@using MudBlazor
@using Tauchplaetze.Core.Features.Accounts
@using Tauchplaetze.Web.Features.Accounts
@inject IStringLocalizer<AdminStrings> L
@inject IServiceScopeFactory Scopes
@inject SusvReviewSignal SusvSignal
@using System.Security.Claims
@using Tauchplaetze.Core.CrossCutting.UseCases
@using Tauchplaetze.Core.Features.Susv.Queries
@using Tauchplaetze.Web.Features.Susv

<MudThemeProvider Theme="AdminTheme.Dark" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<PageTitle>@L["Title"] · tauchplaetze.ch</PageTitle>

<MudLayout>
    <MudAppBar Elevation="0" Dense="true">
        <AdminBrand Area="@L["Title"]" />
        <MudSpacer />
        <AuthorizeView>
            <MudText Typo="Typo.body2" Class="mr-4">@context.User.Identity?.Name</MudText>
        </AuthorizeView>
        <MudLink Href="@($"/{Language}")" Target="_top" Color="Color.Inherit" Underline="Underline.None">@L["Nav_Public"]</MudLink>
    </MudAppBar>
    <MudDrawer Open="true" ClipMode="DrawerClipMode.Always" Elevation="0" Variant="DrawerVariant.Mini" OpenMiniOnHover="false">
        <MudNavMenu>
            <AuthorizeView Roles="@($"{Roles.Moderator},{Roles.Admin}")">
                <MudNavLink Href="/admin" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.Dashboard">@L["Nav_Dashboard"]</MudNavLink>
                <MudNavLink Href="/admin/plaetze" Icon="@Icons.Material.Outlined.Place">@L["Nav_Sites"]</MudNavLink>
                <MudNavLink Href="/admin/vorschlaege" Icon="@Icons.Material.Outlined.FactCheck">@L["Nav_Pending"]</MudNavLink>
                <MudNavLink Href="/admin/meldungen" Icon="@Icons.Material.Outlined.Visibility">@L["Nav_Reports"]</MudNavLink>
                <MudNavLink Href="/admin/susv" Icon="@Icons.Material.Outlined.Flag">
                    @L["Nav_Susv"]
                    @if (susvOpen > 0)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Class="ml-2" data-susv-open>@susvOpen</MudChip>
                    }
                </MudNavLink>
                @if (!context.User.IsInRole(Roles.Admin))
                {
                    <MudNavLink Href="/admin/konten" Icon="@Icons.Material.Outlined.People">@L["Nav_Accounts"]</MudNavLink>
                }
            </AuthorizeView>
            <MudNavLink Href="@AccountPaths.Proposals(Language)" Target="_top" Icon="@Icons.Material.Outlined.Inbox">@L["Nav_MyProposals"]</MudNavLink>
            <AuthorizeView Roles="@Roles.Admin">
                <MudNavLink Href="/platform" Icon="@Icons.Material.Outlined.Tune">@L["Nav_Platform"]</MudNavLink>
            </AuthorizeView>
        </MudNavMenu>
    </MudDrawer>
    <MudMainContent Class="admin-main">
        <MudContainer MaxWidth="MaxWidth.Large" Class="py-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private int susvOpen;

    private string? userId;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    private static string Language => CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;

    /// <summary>Zahl der offenen und geänderten Einträge des SUSV. Ohne Recht 0, dann fehlt die Zahl.</summary>
    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationState is null || (await AuthenticationState).User.FindFirstValue(ClaimTypes.NameIdentifier) is not { } id)
        {
            return;
        }

        userId = id;
        susvOpen = await SusvOpen();
        SusvSignal.Changed += RefreshSusv;
    }

    private async Task<int> SusvOpen()
    {
        await using var scope = Scopes.CreateAsyncScope();
        return await scope.ServiceProvider.GetRequiredService<IQueryHandler<GetSusvReviewCountQuery, int>>().Handle(new GetSusvReviewCountQuery(userId!));
    }

    private async Task RefreshSusv()
    {
        susvOpen = await SusvOpen();
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose() => SusvSignal.Changed -= RefreshSusv;
}
