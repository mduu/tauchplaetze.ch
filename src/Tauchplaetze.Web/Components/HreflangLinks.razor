@using Microsoft.Extensions.Options
@using Tauchplaetze.Core.CrossCutting.Mail
@inject NavigationManager Navigation
@inject IOptions<PublicSiteOptions> Site

@* Gehört in das <HeadContent> der Seite: Von mehreren <HeadContent> zeigt Blazor nur das letzte. *@
@foreach (var language in Languages.All)
{
    <link rel="alternate" hreflang="@language" href="@Absolute(language)" />
}
<link rel="alternate" hreflang="x-default" href="@Absolute(Languages.Default)" />

@code {
    /// <remarks>Adresse aus `PublicSite:BaseUri`, nicht aus der Anfrage: Hinter dem Ingress stimmen Schema und Host der Anfrage nicht. Ohne Query-String.</remarks>
    private string Absolute(string language) => Site.Value.Link(LanguagePaths.Switch(Navigation.ToBaseRelativePath(Navigation.Uri), language));
}
