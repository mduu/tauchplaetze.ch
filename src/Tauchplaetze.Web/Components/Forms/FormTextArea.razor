@* Mehrzeiliges Textfeld im Design der Website. *@
<label class="field">
    <span class="field-label">@Label</span>
    <textarea rows="@Rows" maxlength="@MaxLength" @onchange="Changed">@Value</textarea>
    @if (Help is not null)
    {
        <span class="field-help">@Help</span>
    }
</label>

@code {
    [Parameter, EditorRequired]
    public string Label { get; set; } = "";

    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public EventCallback<string?> ValueChanged { get; set; }

    [Parameter]
    public string? Help { get; set; }

    [Parameter]
    public int Rows { get; set; } = 4;

    [Parameter]
    public int? MaxLength { get; set; }

    private Task Changed(ChangeEventArgs e) => ValueChanged.InvokeAsync(e.Value as string);
}
