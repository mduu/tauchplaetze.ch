@* Bewertung 1 bis 5 oder keine als Radiogruppe, mit der Legende der Skala hinter dem «i» (`dive-site.md`, «Bewertungen»). *@
<div class="level-picker" data-kind="@(IsLevel ? "level" : "quality")">
    <div class="level-head">
        <span class="field-label" id="@labelId">@Label</span>
        <button type="button" class="rating-info" popovertarget="@legendId" data-hover-popover aria-label="@InfoLabel"><span aria-hidden="true">i</span></button>
    </div>
    <fieldset class="level-options" aria-labelledby="@labelId">
        <label class="level-option level-none" data-checked="@(Value is null ? "true" : "false")">
            <input type="radio" name="@name" checked="@(Value is null)" @onchange="() => Pick(null)" />
            <span>@NoneLabel</span>
        </label>
        @for (byte step = 1; step <= 5; step++)
        {
            var current = step;
            <label class="level-option" data-on="@(Value >= current ? "true" : "false")" data-checked="@(Value == current ? "true" : "false")" title="@Legend[current - 1].Short">
                <input type="radio" name="@name" checked="@(Value == current)" aria-label="@($"{current} · {Legend[current - 1].Short}")" @onchange="() => Pick(current)" />
                <span aria-hidden="true">@current</span>
            </label>
        }
    </fieldset>
    <p class="level-current" aria-live="polite">@(Value is { } value ? Legend[value - 1].Short : NoneLabel)</p>
    <div id="@legendId" popover class="rating-legend">
        <p class="rating-legend-title">@Label</p>
        <ol>
            @for (var step = 1; step <= 5; step++)
            {
                <li aria-current="@(step == Value ? "true" : null)">
                    <span class="rating-legend-number">@step</span>
                    <span><strong>@Legend[step - 1].Short</strong> · @Legend[step - 1].Text</span>
                </li>
            }
        </ol>
    </div>
</div>

@code {
    private readonly string id = Guid.NewGuid().ToString("N")[..8];

    private string name => $"level-{id}";

    private string labelId => $"level-label-{id}";

    private string legendId => $"level-legend-{id}";

    [Parameter, EditorRequired]
    public string Label { get; set; } = "";

    [Parameter]
    public byte? Value { get; set; }

    [Parameter]
    public EventCallback<byte?> ValueChanged { get; set; }

    /// <summary>Kurztext und Bedeutung der Stufen 1 bis 5.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<(string Short, string Text)> Legend { get; set; } = [];

    [Parameter, EditorRequired]
    public string NoneLabel { get; set; } = "";

    [Parameter, EditorRequired]
    public string InfoLabel { get; set; } = "";

    /// <summary>Eine Stufe (mehr ist anspruchsvoller) statt einer Qualität (mehr ist besser). Ändert nur die Farbe.</summary>
    [Parameter]
    public bool IsLevel { get; set; }

    private Task Pick(byte? value) => ValueChanged.InvokeAsync(value);
}
