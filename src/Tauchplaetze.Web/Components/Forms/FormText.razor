@* Einzeiliges Textfeld im Design der Website. *@
<label class="field">
    <span class="field-label">@Label</span>
    <input type="text" value="@Value" maxlength="@MaxLength" required="@Required" aria-describedby="@(Help is null ? null : helpId)" @onchange="Changed" />
    @if (Help is not null)
    {
        <span class="field-help" id="@helpId">@Help</span>
    }
</label>

@code {
    private readonly string helpId = "help-" + Guid.NewGuid().ToString("N")[..8];

    [Parameter, EditorRequired]
    public string Label { get; set; } = "";

    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public EventCallback<string?> ValueChanged { get; set; }

    [Parameter]
    public string? Help { get; set; }

    [Parameter]
    public int? MaxLength { get; set; }

    [Parameter]
    public bool Required { get; set; }

    private Task Changed(ChangeEventArgs e) => ValueChanged.InvokeAsync(e.Value as string);
}
