@* Dezimalzahl mit Punkt oder Komma, leer erlaubt. Eine ungültige Eingabe bleibt stehen und zeigt einen Hinweis, statt still zu verschwinden. *@
@inject IStringLocalizer<SharedStrings> L

<label class="field field-short">
    <span class="field-label">@Label</span>
    <span class="field-unit-wrap">
        <input type="text" inputmode="decimal" value="@(raw ?? Value?.ToString(CultureInfo.InvariantCulture))"
               aria-invalid="@(invalid ? "true" : null)" aria-describedby="@(invalid ? errorId : null)" @onchange="Changed" />
        @if (Unit is not null)
        {
            <span class="field-unit">@Unit</span>
        }
    </span>
    @if (invalid)
    {
        <span class="field-error" id="@errorId">@L["Form_InvalidNumber", Min, Max]</span>
    }
</label>

@code {
    private readonly string errorId = "error-" + Guid.NewGuid().ToString("N")[..8];

    private string? raw;

    private bool invalid;

    [Parameter, EditorRequired]
    public string Label { get; set; } = "";

    [Parameter]
    public decimal? Value { get; set; }

    [Parameter]
    public EventCallback<decimal?> ValueChanged { get; set; }

    [Parameter]
    public decimal Min { get; set; }

    [Parameter]
    public decimal Max { get; set; } = 100_000;

    [Parameter]
    public string? Unit { get; set; }

    private async Task Changed(ChangeEventArgs e)
    {
        var text = (e.Value as string)?.Trim().Replace(',', '.') ?? "";
        if (text.Length == 0)
        {
            (raw, invalid) = (null, false);
            await ValueChanged.InvokeAsync(null);
            return;
        }

        if (decimal.TryParse(text, NumberStyles.Number, CultureInfo.InvariantCulture, out var number) && number >= Min && number <= Max)
        {
            (raw, invalid) = (null, false);
            await ValueChanged.InvokeAsync(number);
            return;
        }

        (raw, invalid) = (text, true);
    }
}
