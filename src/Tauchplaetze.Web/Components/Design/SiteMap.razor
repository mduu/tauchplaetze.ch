@using System.Text.Json
@using Tauchplaetze.Core.Features.DiveSites.Queries
@using Tauchplaetze.Web.Features.Forecasts
@inject IStringLocalizer<DiveSiteStrings> L

<div class="site-map" data-map data-sites="@Json" data-cluster="@(Cluster ? "true" : null)" data-lat="@Invariant(Latitude)" data-lng="@Invariant(Longitude)" data-zoom="@Zoom" data-layer-map="@L["Map_Layer_Map"]" data-layer-photo="@L["Map_Layer_Photo"]"
     role="region" aria-label="@L["Map_Label"]"></div>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<DiveSiteListItem> Sites { get; set; } = [];

    [Parameter]
    public double Latitude { get; set; } = 46.8;

    [Parameter]
    public double Longitude { get; set; } = 8.2;

    [Parameter]
    public int Zoom { get; set; } = 8;

    /// <summary>Fasst nahe Plätze zu Gruppen mit Anzahl zusammen (Leaflet.markercluster), für viele Punkte.</summary>
    [Parameter]
    public bool Cluster { get; set; }

    private static string Language => CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;

    private string Json => JsonSerializer.Serialize(Sites.Select(s => new
    {
        lat = s.Latitude,
        lng = s.Longitude,
        name = s.Name,
        url = PublicRoutes.DiveSite(Language, s.Slug),
        band = ForecastFormat.IndexBand(s.DiveIndexToday),
        index = s.DiveIndexToday is { } index ? ForecastFormat.Number(index) : null,
    }));

    private static string Invariant(double value) => value.ToString(CultureInfo.InvariantCulture);
}
