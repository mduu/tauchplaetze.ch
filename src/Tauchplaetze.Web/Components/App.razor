<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#071417" />
    <link rel="icon" href="@Assets["favicon.ico"]" sizes="48x48" />
    <link rel="icon" href="@Assets["icons/favicon-32.png"]" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="@Assets["icons/apple-touch-icon.png"]" />
    <base href="/" />
    <link rel="preload" href="@Assets["fonts/bricolage-grotesque-latin-wght.woff2"]" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="@Assets["lib/leaflet/leaflet.css"]" />
    <link rel="stylesheet" href="@Assets["lib/leaflet.markercluster/MarkerCluster.css"]" />
    <link rel="stylesheet" href="@Assets["css/fonts.css"]" />
    <link rel="stylesheet" href="@Assets["css/tokens.css"]" />
    <link rel="stylesheet" href="@Assets["css/base.css"]" />
    @if (IsAdmin)
    {
        <link rel="stylesheet" href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" />
    }
    <link rel="stylesheet" href="@Assets["Tauchplaetze.Web.styles.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body>
    <Routes @rendermode="PageRenderMode" />
    <script src="_framework/blazor.web.js"></script>
    <script src="@Assets["lib/leaflet/leaflet.js"]"></script>
    <script src="@Assets["lib/leaflet.markercluster/leaflet.markercluster.js"]"></script>
    <script src="@Assets["js/map.js"]"></script>
    <script src="@Assets["js/sketch.js"]"></script>
    <script src="@Assets["js/site.js"]"></script>
    @if (IsAdmin)
    {
        <script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>
        <script src="@Assets["js/admin.js"]"></script>
    }
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    /// <summary>Moderation und Plattform sind interaktiv mit MudBlazor (ADR-001). Die öffentlichen Seiten bleiben Static SSR.</summary>
    private bool IsAdmin => HttpContext.Request.Path.StartsWithSegments("/admin") || HttpContext.Request.Path.StartsWithSegments("/platform");

    /// <summary>Der Bearbeiten-Modus eines Platzes ist interaktiv, aber im Layout der Website und ohne MudBlazor (ADR-001, Nachtrag).</summary>
    private bool IsEditMode => PublicRoutes.IsDiveSiteEdit(HttpContext.Request.Path.Value);

    private IComponentRenderMode? PageRenderMode => IsAdmin || IsEditMode ? InteractiveServer : null;

    protected override void OnInitialized()
    {
        if (PageRenderMode is not null)
        {
            CircuitCultureProvider.Remember(HttpContext, CultureInfo.CurrentUICulture.TwoLetterISOLanguageName);
        }
    }
}
