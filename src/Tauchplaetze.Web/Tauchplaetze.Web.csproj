<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <UserSecretsId>3e1c9a4d-6b2f-4f7e-8d5a-2c9b7e4f1a10</UserSecretsId>
    <!-- Workstation GC: eine Instanz auf einem Kern (B1). Server GC hielt 250–420 MB Heap und pausierte die Seiten (infrastructure.md, «Betrieb»). -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MudBlazor" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Tauchplaetze.Core/Tauchplaetze.Core.csproj" />
    <ProjectReference Include="../Tauchplaetze.ServiceDefaults/Tauchplaetze.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tauchplaetze.Web.Tests" />
  </ItemGroup>

</Project>
