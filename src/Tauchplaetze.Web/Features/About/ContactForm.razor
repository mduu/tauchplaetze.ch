@using Tauchplaetze.Core.CrossCutting.UseCases
@using Tauchplaetze.Core.Features.Contact.Commands
@using Tauchplaetze.Web.CrossCutting.Security
@inject ICommandHandler<SendContactMessageCommand, ContactResult> SendMessage
@inject FormBotTrap Trap
@inject IStringLocalizer<AboutStrings> L
@inject NavigationManager Navigation

@if (Status == ContactStatus.Sent)
{
    <p class="contact-message" role="status">@L["Contact_Sent"]</p>
}
else
{
    @if (errors.Count > 0)
    {
        <ul class="contact-errors" role="alert">
            @foreach (var error in errors)
            {
                <li>@error</li>
            }
        </ul>
    }

    <EditForm Model="Input" FormName="contact" OnSubmit="Submit" class="form contact-form">
        <input type="hidden" name="Input.Stamp" value="@stamp" />
        <label>@L["Contact_Name"] <InputText autocomplete="name" maxlength="@ContactRules.MaxName" @bind-Value="Input!.Name" /></label>
        <label>@L["Contact_Email"] <InputText type="email" autocomplete="email" required maxlength="@ContactRules.MaxEmail" @bind-Value="Input!.Email" /></label>
        <label>@L["Contact_Reference"] <InputText maxlength="@ContactRules.MaxReference" @bind-Value="Input!.Reference" /></label>
        <label>@L["Contact_Message"] <InputTextArea required rows="7" minlength="@ContactRules.MinMessage" maxlength="@ContactRules.MaxMessage" @bind-Value="Input!.Message" /></label>
        <label class="form-trap" aria-hidden="true">@L["Contact_Trap"] <InputText tabindex="-1" autocomplete="off" @bind-Value="Input!.Website" /></label>
        <button type="submit" class="button">@L["Contact_Submit"]</button>
    </EditForm>
}

@code {
    /// <summary>Name der Policy für das Rate Limit (`ContactRateLimit`).</summary>
    public const string RateLimitPolicy = "contact";

    private const string Form = "ContactForm";

    private IReadOnlyList<string> errors = [];

    private string stamp = "";

    [Parameter]
    public ContactStatus Status { get; set; }

    [Parameter]
    public string? Reference { get; set; }

    [Parameter, EditorRequired]
    public string SentUrl { get; set; } = "";

    [SupplyParameterFromForm(FormName = "contact")]
    private ContactInput? Input { get; set; }

    private static string Language => CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;

    protected override void OnInitialized()
    {
        Input ??= new ContactInput { Reference = Reference };

        stamp = Trap.KeepStamp(Form, Input.Stamp);
        if (Status == ContactStatus.Limited)
        {
            errors = [L["Contact_Error_Limit"]];
        }
    }

    /// <remarks>
    /// Honeypot und Zeitfalle (<see cref="FormBotTrap"/>) schützen den Transport. Ein Bot sieht trotzdem «gesendet» und lernt nichts.
    /// Die Inhalte prüft der Core.
    /// </remarks>
    private async Task Submit()
    {
        var trap = Trap.Check(Form, Input!.Stamp, Input.Website);
        if (trap == FormTrapResult.Bot)
        {
            Navigation.NavigateTo(SentUrl);
            return;
        }

        if (trap == FormTrapResult.Expired)
        {
            stamp = Trap.NewStamp(Form);
            errors = [L["Contact_Error_Expired"]];
            return;
        }

        var result = await SendMessage.Handle(new SendContactMessageCommand(Input.Name, Input.Email ?? "", Input.Message ?? "", Input.Reference, Language));
        if (result.Succeeded)
        {
            Navigation.NavigateTo(SentUrl);
            return;
        }

        errors = [.. result.Errors.Select(e => L[$"Contact_Error_{e}"].Value)];
    }

    private sealed class ContactInput
    {
        public string? Name { get; set; }

        public string? Email { get; set; }

        public string? Reference { get; set; }

        public string? Message { get; set; }

        public string? Stamp { get; set; }

        /// <summary>Honeypot: Menschen sehen das Feld nicht und lassen es leer.</summary>
        public string? Website { get; set; }
    }
}
