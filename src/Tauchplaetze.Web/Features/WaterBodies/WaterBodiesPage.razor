@page "/de/gewaesser"
@page "/en/waters"
@page "/fr/eaux"
@page "/it/acque"
@using Tauchplaetze.Core.CrossCutting.UseCases
@using Tauchplaetze.Core.Features.WaterBodies
@using Tauchplaetze.Core.Features.WaterBodies.Queries
@inject IQueryHandler<GetWaterBodyGroupsQuery, IReadOnlyList<WaterBodyGroup>> WaterBodyGroups
@inject IStringLocalizer<SharedStrings> Shared
@inject IStringLocalizer<DiveSiteStrings> L

<PageTitle>@L["WaterBodies_Title"] · @Shared["Brand"]</PageTitle>
<HeadContent>
    <meta name="description" content="@L["WaterBodies_MetaDescription"]" />
    <HreflangLinks />
</HeadContent>

<section class="page-section">
    <h1 class="page-title">@L["WaterBodies_Title"]</h1>
    <p class="lead">@L["WaterBodies_Lead"]</p>

    @if (groups.Count > 1)
    {
        <nav class="water-jump" aria-label="@L["WaterBodies_Jump"]">
            @foreach (var group in groups)
            {
                <a href="@($"{Path}#{Anchor(group)}")">@Title(group)</a>
            }
        </nav>
    }

    <div class="waters">
        <div class="water-groups">
            @foreach (var group in groups)
            {
                <section class="water-group" id="@Anchor(group)" aria-labelledby="@($"{Anchor(group)}-title")">
                    <h2 id="@($"{Anchor(group)}-title")" class="water-group-title">@Title(group)</h2>
                    @if (group.Kind == WaterBodyGroupKind.LargeLakes)
                    {
                        <ul class="water-panels">
                            @foreach (var water in group.Waters)
                            {
                                <li class="tile">
                                    <div class="tile-label">@L[$"WaterBody_{water.Type}"]</div>
                                    <a href="@Link(water)">@water.Name</a>
                                    <p class="water-count">@SiteCount(water.SiteCount)</p>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <ul class="water-list">
                            @foreach (var water in group.Waters)
                            {
                                <li>
                                    <a href="@Link(water)">@water.Name</a>
                                    <span class="water-list-count" aria-hidden="true">@water.SiteCount</span>
                                    <span class="visually-hidden">@SiteCount(water.SiteCount)</span>
                                </li>
                            }
                        </ul>
                    }
                </section>
            }
        </div>
        <WaterMap Waters="allWaters" />
    </div>
</section>

@code {
    private IReadOnlyList<WaterBodyGroup> groups = [];

    private IReadOnlyList<WaterBodySummary> allWaters = [];

    private static string Language => CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;

    private static string Path => $"/{Language}/{PublicRoutes.WaterBodies[Language]}";

    protected override async Task OnInitializedAsync()
    {
        groups = await WaterBodyGroups.Handle(new GetWaterBodyGroupsQuery(Language));
        allWaters = [.. groups.SelectMany(g => g.Waters)];
    }

    private static string Link(WaterBodySummary water) => $"{Path}/{water.Slug}";

    private static string Anchor(WaterBodyGroup group) => group.Region is { } region
        ? $"region-{region.ToString().ToLowerInvariant()}"
        : group.Kind.ToString().ToLowerInvariant();

    private string Title(WaterBodyGroup group) => group.Region is { } region
        ? L[$"Region_{region}"]
        : L[$"WaterBodies_Group_{group.Kind}"];

    private string SiteCount(int count) => count switch
    {
        0 => L["WaterBodies_Sites_None"],
        1 => L["WaterBodies_Sites_One"],
        _ => L["WaterBodies_Sites_Many", count],
    };
}
