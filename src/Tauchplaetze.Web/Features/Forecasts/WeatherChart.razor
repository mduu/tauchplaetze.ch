@using Tauchplaetze.Core.Features.Forecasts
@inject IStringLocalizer<ForecastStrings> L
@inject TimeProvider Time

@* Wetter im 2-h-Raster wie bei MeteoSchweiz, kompakt für die Kachel «Die nächsten 5 Tage» (design-system.md, WeatherChart). *@
<div class="weather">
    <div class="weather-scroll">
        <svg class="weather-chart" viewBox="0 0 @Svg(Width) @Svg(Height)" role="img" aria-labelledby="weather-title weather-desc">
            <title id="weather-title">@L["Weather_Title"]</title>
            <desc id="weather-desc">@Description</desc>
            <defs>
                <g id="wx-cloud"><path d="M9 25h14.5a5.5 5.5 0 0 0 .6-11 7.5 7.5 0 0 0-14.3-1.8A6.4 6.4 0 0 0 9 25z" fill="var(--color-text-muted)" /></g>
                <g id="wx-sun-shape">
                    <circle cx="16" cy="16" r="6" fill="var(--color-sun)" />
                    <g stroke="var(--color-sun)" stroke-width="2" stroke-linecap="round">
                        <line x1="16" y1="3" x2="16" y2="6.5" /><line x1="16" y1="25.5" x2="16" y2="29" /><line x1="3" y1="16" x2="6.5" y2="16" /><line x1="25.5" y1="16" x2="29" y2="16" />
                        <line x1="6.8" y1="6.8" x2="9.3" y2="9.3" /><line x1="22.7" y1="22.7" x2="25.2" y2="25.2" /><line x1="6.8" y1="25.2" x2="9.3" y2="22.7" /><line x1="22.7" y1="9.3" x2="25.2" y2="6.8" />
                    </g>
                </g>
                <g id="wx-moon-shape"><path d="M20.5 5.5a10.5 10.5 0 1 0 6 18.6A9 9 0 0 1 20.5 5.5z" fill="var(--color-text-body)" /></g>
                <symbol id="wx-clear-day" viewBox="0 0 32 32"><use href="#wx-sun-shape" /></symbol>
                <symbol id="wx-clear-night" viewBox="0 0 32 32"><use href="#wx-moon-shape" /></symbol>
                <symbol id="wx-partly-day" viewBox="0 0 32 32"><use href="#wx-sun-shape" transform="translate(-2 -3) scale(0.75)" /><use href="#wx-cloud" transform="translate(2 1)" /></symbol>
                <symbol id="wx-partly-night" viewBox="0 0 32 32"><use href="#wx-moon-shape" transform="translate(-1 -3) scale(0.7)" /><use href="#wx-cloud" transform="translate(2 1)" /></symbol>
                <symbol id="wx-cloudy" viewBox="0 0 32 32"><use href="#wx-cloud" /></symbol>
                <symbol id="wx-fog" viewBox="0 0 32 32">
                    <g stroke="var(--color-text-muted)" stroke-width="2.4" stroke-linecap="round"><line x1="5" y1="11" x2="27" y2="11" /><line x1="8" y1="17" x2="24" y2="17" /><line x1="5" y1="23" x2="27" y2="23" /></g>
                </symbol>
                <symbol id="wx-drizzle" viewBox="0 0 32 32">
                    <use href="#wx-cloud" transform="translate(0 -4)" />
                    <g fill="var(--color-rain)"><circle cx="11" cy="26" r="1.4" /><circle cx="17" cy="28" r="1.4" /><circle cx="23" cy="26" r="1.4" /></g>
                </symbol>
                <symbol id="wx-rain" viewBox="0 0 32 32">
                    <use href="#wx-cloud" transform="translate(0 -4)" />
                    <g stroke="var(--color-rain)" stroke-width="2" stroke-linecap="round"><line x1="11" y1="24" x2="9.5" y2="29" /><line x1="17" y1="24" x2="15.5" y2="29" /><line x1="23" y1="24" x2="21.5" y2="29" /></g>
                </symbol>
                <symbol id="wx-showers" viewBox="0 0 32 32">
                    <use href="#wx-sun-shape" transform="translate(-2 -4) scale(0.7)" />
                    <use href="#wx-cloud" transform="translate(2 -3)" />
                    <g stroke="var(--color-rain)" stroke-width="2" stroke-linecap="round"><line x1="14" y1="25" x2="12.5" y2="30" /><line x1="21" y1="25" x2="19.5" y2="30" /></g>
                </symbol>
                <symbol id="wx-snow" viewBox="0 0 32 32">
                    <use href="#wx-cloud" transform="translate(0 -4)" />
                    <g fill="var(--color-text)"><circle cx="11" cy="26" r="1.8" /><circle cx="17" cy="28.5" r="1.8" /><circle cx="23" cy="26" r="1.8" /></g>
                </symbol>
                <symbol id="wx-thunder" viewBox="0 0 32 32">
                    <use href="#wx-cloud" transform="translate(0 -4)" />
                    <path d="M17 20l-4 6h3.5l-2 5 6-7h-3.5l2-4z" fill="var(--color-sun)" />
                </symbol>
            </defs>

            @* Nacht und Vergangenheit *@
            @foreach (var (first, count) in NightRuns)
            {
                <rect class="night" x="@Svg(X(first))" y="@Svg(SymbolTop)" width="@Svg(count * SlotWidth)" height="@Svg(MainBottom - SymbolTop)" />
            }
            @if (NowOffset is { } now)
            {
                <rect class="past" x="@Svg(Left)" y="@Svg(SymbolTop)" width="@Svg(now * SlotWidth)" height="@Svg(MainBottom - SymbolTop)" />
            }

            @* Gitter und Achsen *@
            <line class="axis" x1="@Svg(Left)" y1="@Svg(SunBottom)" x2="@Svg(Right)" y2="@Svg(SunBottom)" />
            <line class="axis" x1="@Svg(Left)" y1="@Svg(MainBottom)" x2="@Svg(Right)" y2="@Svg(MainBottom)" />
            @foreach (var tick in TemperatureTicks)
            {
                <line class="grid" x1="@Svg(Left)" y1="@Svg(TemperatureY(tick))" x2="@Svg(Right)" y2="@Svg(TemperatureY(tick))" />
                <SvgText class="tick" x="@Svg(Left - 4)" y="@Svg(TemperatureY(tick) + 3)" text-anchor="end" Content="@($"{tick}°")" />
            }
            <SvgText class="tick tick-rain" x="@Svg(Right + 4)" y="@Svg(MainTop + 3)" Content="@Svg((double)RainMax)" />
            <SvgText class="tick tick-rain" x="@Svg(Right + 4)" y="@Svg(MainBottom)" Content="0" />
            <SvgText class="tick tick-sun" x="@Svg(Left - 4)" y="@Svg(SunTop + 6)" text-anchor="end" Content="60" />

            @* Tage *@
            @foreach (var day in Days)
            {
                <line class="midnight" x1="@Svg(X(day.Offset))" y1="0" x2="@Svg(X(day.Offset))" y2="@Svg(MainBottom + 4)" />
                <SvgText class="day-label" x="@Svg(X(day.Offset) + 4)" y="11" Content="@day.Label" />
            }
            @foreach (var hour in AxisHours)
            {
                <SvgText class="tick" x="@Svg(X(hour.Offset))" y="@Svg(MainBottom + 13)" text-anchor="middle" Content="@hour.Label" />
            }

            @* Symbole nur beim Wechsel, dazwischen eine gepunktete Linie *@
            @foreach (var change in SymbolChanges)
            {
                var center = X(change.Offset + 0.5);
                @if (change.LineTo is { } next)
                {
                    <line class="same-weather" x1="@Svg(center + SymbolSize / 2 + 2)" y1="@Svg(SymbolTop + SymbolSize / 2)" x2="@Svg(X(next + 0.5) - SymbolSize / 2 - 2)" y2="@Svg(SymbolTop + SymbolSize / 2)" />
                }
                <g>
                    <title>@L[$"Wx_{change.Symbol}"]</title>
                    <use href="#@change.Id" x="@Svg(center - SymbolSize / 2)" y="@Svg(SymbolTop)" width="@Svg(SymbolSize)" height="@Svg(SymbolSize)" />
                </g>
            }

            @* Wind alle 6 h *@
            @foreach (var wind in Winds)
            {
                var center = X(wind.Offset);
                @if (wind.Direction is { } direction)
                {
                    <path class="wind-arrow" d="M0 -5L3.6 0.8H1.2V5H-1.2V0.8H-3.6Z" transform="translate(@Svg(center) @Svg(WindArrowY)) rotate(@Svg((direction + 180) % 360))" />
                }
                <SvgText class="wind-value" x="@Svg(center)" y="@Svg(WindValueY)" text-anchor="middle" Content="@Svg(Math.Round(wind.Kmh))" />
            }

            @* Sonne, Regen und Temperatur pro 2 h *@
            @foreach (var slot in Slots)
            {
                @if (slot.SunshineMinutes is > 0 and var minutes)
                {
                    var height = Math.Min(minutes, 60) / 60 * (SunBottom - SunTop);
                    <rect class="sun-bar" x="@Svg(X(slot.Offset) + 1)" y="@Svg(SunBottom - height)" width="@Svg(SlotWidth - 2)" height="@Svg(height)" />
                }
                @if (slot.RainMm is > 0 and var rain)
                {
                    var top = RainY(rain);
                    <rect class="rain-bar" x="@Svg(X(slot.Offset) + 1)" y="@Svg(top)" width="@Svg(SlotWidth - 2)" height="@Svg(MainBottom - top)" />
                }
            }
            @foreach (var line in TemperatureLines)
            {
                <polyline class="temperature" points="@line" />
            }

            @if (NowOffset is { } nowLine)
            {
                <line class="now" x1="@Svg(X(nowLine))" y1="@Svg(SymbolTop)" x2="@Svg(X(nowLine))" y2="@Svg(MainBottom)" />
            }
        </svg>
    </div>
    <ul class="weather-legend">
        <li><span class="swatch swatch-temperature"></span>@L["Weather_Temperature"]</li>
        <li><span class="swatch swatch-rain"></span>@L["Weather_Rain"]</li>
        <li><span class="swatch swatch-sun"></span>@L["Weather_Sun"]</li>
        <li><span class="swatch swatch-wind"></span>@L["Weather_Wind"]</li>
    </ul>
</div>

@code {
    private const int SlotHours = 2;

    private const double SlotWidth = 9;

    private const double Left = 30;

    private const double SymbolTop = 16;

    private const double SymbolSize = 20;

    private const double WindArrowY = 46;

    private const double WindValueY = 64;

    private const double SunTop = 70;

    private const double SunBottom = 86;

    private const double MainTop = 94;

    private const double MainBottom = 160;

    private const double Height = 178;

    private const int WindEverySlots = 3;

    private static readonly TimeZoneInfo Zone = TimeZoneInfo.FindSystemTimeZoneById("Europe/Zurich");

    [Parameter, EditorRequired]
    public IReadOnlyList<WeatherHourForecast> Hours { get; set; } = [];

    private List<Slot>? slots;

    private List<Slot> Slots => slots ??= Enumerable.Range(0, Hours.Count / SlotHours).Select(ToSlot).ToList();

    private double Right => Left + Slots.Count * SlotWidth;

    private double Width => Right + 22;

    private DateTime Start => Hours[0].LocalTime;

    private double X(double slotOffset) => Left + slotOffset * SlotWidth;

    private double? NowOffset
    {
        get
        {
            var now = TimeZoneInfo.ConvertTime(Time.GetUtcNow(), Zone).DateTime;
            var offset = (now - Start).TotalHours / SlotHours;
            return offset > 0 && offset < Slots.Count ? offset : null;
        }
    }

    private Slot ToSlot(int index)
    {
        var hours = Hours.Skip(index * SlotHours).Take(SlotHours).ToList();
        var symbols = hours.Where(h => h.Symbol is not null).Select(h => h.Symbol!.Value).ToList();
        return new Slot(
            index,
            hours[0].LocalTime,
            symbols.Count > 0 ? symbols.Max() : null,
            hours.All(h => h.IsDay == false),
            Average(hours.Select(h => h.TemperatureC)),
            Average(hours.Select(h => h.PrecipitationMm)),
            Average(hours.Select(h => h.SunshineMinutes is { } m ? (decimal)m : (decimal?)null)),
            hours);
    }

    private static double? Average(IEnumerable<decimal?> values)
    {
        var present = values.OfType<decimal>().ToList();
        return present.Count > 0 ? (double)present.Average() : null;
    }

    private IEnumerable<(int Offset, string Label)> Days => Slots
        .Where(s => s.Time.Hour == 0)
        .Select(s => (s.Offset, DayLabel(DateOnly.FromDateTime(s.Time))));

    private IEnumerable<(int Offset, string Label)> AxisHours => Slots
        .Where(s => s.Time.Hour is 6 or 12 or 18)
        .Select(s => (s.Offset, s.Time.ToString("HH", CultureInfo.InvariantCulture)));

    private IEnumerable<(int First, int Count)> NightRuns
    {
        get
        {
            int? first = null;
            for (var i = 0; i <= Slots.Count; i++)
            {
                var night = i < Slots.Count && Slots[i].IsNight;
                if (night && first is null)
                {
                    first = i;
                }
                else if (!night && first is { } begin)
                {
                    yield return (begin, i - begin);
                    first = null;
                }
            }
        }
    }

    /// <summary>Ein Symbol beim ersten Slot und bei jedem Wechsel. Die Linie führt bis zum nächsten Wechsel.</summary>
    private IEnumerable<SymbolChange> SymbolChanges
    {
        get
        {
            var changes = new List<(int Offset, WeatherSymbol Symbol, string Id)>();
            foreach (var slot in Slots.Where(s => s.Symbol is not null))
            {
                var id = SymbolId(slot.Symbol!.Value, slot.IsNight);
                if (changes.Count == 0 || changes[^1].Id != id)
                {
                    changes.Add((slot.Offset, slot.Symbol.Value, id));
                }
            }

            for (var i = 0; i < changes.Count; i++)
            {
                var next = i + 1 < changes.Count ? changes[i + 1].Offset : Slots.Count - 1;
                yield return new SymbolChange(changes[i].Offset, changes[i].Symbol, changes[i].Id, next - changes[i].Offset > 2 ? next : null);
            }
        }
    }

    private IEnumerable<(double Offset, double Kmh, int? Direction)> Winds => Slots
        .Chunk(WindEverySlots)
        .Select(chunk => (Hours: chunk.SelectMany(s => s.Hours).ToList(), chunk[0].Offset, chunk.Length))
        .Where(c => c.Hours.Any(h => h.WindSpeedKmh is not null))
        .Select(c => (
            c.Offset + c.Length / 2.0,
            (double)c.Hours.Where(h => h.WindSpeedKmh is not null).Average(h => h.WindSpeedKmh!.Value),
            c.Hours[c.Hours.Count / 2].WindDirection));

    private (int Min, int Max) TemperatureRange
    {
        get
        {
            var values = Slots.Where(s => s.TemperatureC is not null).Select(s => s.TemperatureC!.Value).ToList();
            if (values.Count == 0)
            {
                return (0, 20);
            }

            var min = (int)Math.Floor(values.Min() / 5) * 5;
            var max = (int)Math.Ceiling(values.Max() / 5) * 5;
            return max - min < 10 ? (min, min + 10) : (min, max);
        }
    }

    private IEnumerable<int> TemperatureTicks
    {
        get
        {
            var (min, max) = TemperatureRange;
            for (var tick = min; tick <= max; tick += 5)
            {
                yield return tick;
            }
        }
    }

    private double TemperatureY(double value)
    {
        var (min, max) = TemperatureRange;
        return MainBottom - (value - min) / (max - min) * (MainBottom - MainTop);
    }

    private decimal RainMax => Math.Max(4, Math.Ceiling((decimal)Slots.Max(s => s.RainMm ?? 0)));

    private double RainY(double value) => MainBottom - Math.Min(value, (double)RainMax) / (double)RainMax * (MainBottom - MainTop);

    private IEnumerable<string> TemperatureLines
    {
        get
        {
            var points = new List<string>();
            foreach (var slot in Slots)
            {
                if (slot.TemperatureC is { } temperature)
                {
                    points.Add($"{Svg(X(slot.Offset + 0.5))},{Svg(TemperatureY(temperature))}");
                }
                else if (points.Count > 0)
                {
                    yield return string.Join(' ', points);
                    points = [];
                }
            }

            if (points.Count > 0)
            {
                yield return string.Join(' ', points);
            }
        }
    }

    private string Description => string.Join(" ", Hours
        .GroupBy(h => DateOnly.FromDateTime(h.LocalTime))
        .Where(day => day.Any(h => h.TemperatureC is not null))
        .Select(day => L["Weather_DaySummary",
            DayLabel(day.Key),
            Rounded(day.Where(h => h.TemperatureC is not null).Min(h => h.TemperatureC!.Value)),
            Rounded(day.Where(h => h.TemperatureC is not null).Max(h => h.TemperatureC!.Value)),
            ForecastFormat.Number(day.Sum(h => h.PrecipitationMm ?? 0)),
            Rounded(day.Max(h => h.WindSpeedKmh ?? 0))].Value));

    private string DayLabel(DateOnly day) =>
        day == DateOnly.FromDateTime(TimeZoneInfo.ConvertTime(Time.GetUtcNow(), Zone).DateTime)
            ? L["Day_Today"]
            : $"{ForecastFormat.Weekday(day)} {day.ToString("dd.MM.", CultureInfo.InvariantCulture)}";

    private static string Rounded(decimal value) => Math.Round(value).ToString("0", CultureInfo.CurrentCulture);

    private static string SymbolId(WeatherSymbol symbol, bool night) => symbol switch
    {
        WeatherSymbol.Clear => night ? "wx-clear-night" : "wx-clear-day",
        WeatherSymbol.PartlyCloudy => night ? "wx-partly-night" : "wx-partly-day",
        WeatherSymbol.Cloudy => "wx-cloudy",
        WeatherSymbol.Fog => "wx-fog",
        WeatherSymbol.Drizzle => "wx-drizzle",
        WeatherSymbol.Rain => "wx-rain",
        WeatherSymbol.Showers => night ? "wx-rain" : "wx-showers",
        WeatherSymbol.Snow => "wx-snow",
        _ => "wx-thunder",
    };

    private static string Svg(double value) => value.ToString("0.#", CultureInfo.InvariantCulture);

    private sealed record Slot(int Offset, DateTime Time, WeatherSymbol? Symbol, bool IsNight, double? TemperatureC, double? RainMm, double? SunshineMinutes, IReadOnlyList<WeatherHourForecast> Hours);

    private sealed record SymbolChange(int Offset, WeatherSymbol Symbol, string Id, int? LineTo);
}
