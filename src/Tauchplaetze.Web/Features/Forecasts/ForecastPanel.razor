@using Tauchplaetze.Core.Features.Forecasts
@inject IStringLocalizer<ForecastStrings> L

<div class="conditions-head">
    <div>
        <p class="eyebrow">@Eyebrow</p>
        <h2 id="conditions" class="section-title">@L[ForecastFormat.Headline(Today)]</h2>
    </div>
    @if (Today.DiveIndex is { } index)
    {
        <div class="index" data-index-band="@ForecastFormat.IndexBand(index)">
            <span class="index-value">@ForecastFormat.Number(index)</span>
            <div class="index-side">
                @if (IndexTrend is { } trend)
                {
                    <div class="index-trend" title="@trend.Aria">
                        <LineChart Series="[trend.Series]" Markers="trend.Markers" Compact="true" ShowDots="false" MaxGap="trend.Range.MaxGap" AriaLabel="@trend.Aria" />
                        <span class="index-trend-range">@ShortDate(trend.Range.From)–@ShortDate(trend.Range.To)</span>
                    </div>
                }
                <span class="index-label">@L["Index_Label"]</span>
            </div>
        </div>
    }
</div>

<div class="conditions-grid" data-profile="@(Forecast.HasDepthProfile ? "true" : "false")">
    <div class="tiles">
        <div class="stat">
            <div class="label">@L["Tile_Visibility"]</div>
            <div class="stat-value">@L[$"Visibility_{Today.VisibilityIndicator}"]</div>
            <div class="stat-note">@VisibilityNote</div>
            @if (Forecast.HasSatellite && History is not null)
            {
                <TileSparkline Series="VisibilitySpark" Caption="@SparkCaption" AriaLabel="@L["Spark_Visibility_Aria"]" MaxGap="SparkGap" />
            }
        </div>
        <div class="stat">
            <div class="label">@L["Tile_Wind"]</div>
            @if (Today.WindBeaufort is { } bft)
            {
                <div class="stat-value">@L["Wind_Value", bft]</div>
                <div class="stat-note">@L["Wind_Detail", ForecastFormat.Meters(Today.WindSpeedKmh ?? 0), ForecastFormat.Meters(Today.WindGustsKmh ?? 0)]</div>
                <TileSparkline Series="WindSpark" Caption="@L["Spark_Next5"]" AriaLabel="@L["Spark_Wind_Aria"]" ShowDots="true" />
            }
            else
            {
                <div class="stat-value">@L["Wind_Unknown"]</div>
            }
        </div>
        @if (Forecast.HasSatellite)
        {
            <div class="stat">
                <div class="label">@L["Tile_Algae"]</div>
                <div class="stat-value">@L[$"Algae_{Today.AlgaeLevel}"]</div>
                @if (History is not null)
                {
                    <TileSparkline Series="AlgaeSpark" Caption="@SparkCaption" AriaLabel="@L["Spark_Algae_Aria"]" MaxGap="SparkGap" />
                }
            </div>
        }
        @if (Today is { CurrentLevel: { } level, CurrentSpeed: { } speed, CurrentDirection: { } direction })
        {
            <div class="stat" data-current="@level">
                <div class="label">@L["Tile_Current"]</div>
                <div class="stat-value">
                    <svg class="current-arrow" width="18" height="18" viewBox="0 0 18 18" aria-hidden="true" style="transform: rotate(@(direction)deg)">
                        <path d="M9 2v14M9 2l-4 5M9 2l4 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    @L[$"Current_{level}"]
                </div>
                <div class="stat-note">@L["Current_Detail", ForecastFormat.CentimetresPerSecond(speed), L[$"Compass_{ForecastFormat.Compass(direction)}"]]</div>
            </div>
        }
        @if (Discharge is { Temperature: { } temperature })
        {
            <WaterTemperatureTile Temperature="temperature" StationName="@Discharge.StationName" />
        }
        @if (Discharge is not null)
        {
            <DischargeTile Discharge="Discharge" />
        }
    </div>

    @if (Forecast.HasDepthProfile)
    {
        <figure class="card profile">
            <figcaption class="profile-title">@L["Profile_Title"]</figcaption>
            <p class="profile-note">@ProfileNote</p>
            <TemperatureProfileChart Day="Today" />
        </figure>
    }

    <div class="days">
        <div class="days-title">@L["Days_Title"]</div>
        <ol>
            @foreach (var day in Forecast.Days)
            {
                <li data-outlook="@(day.IsOutlook ? "true" : "false")">
                    <div class="day-name">@(day.Date == Today.Date ? L["Day_Today"] : ForecastFormat.Weekday(day.Date))</div>
                    @if (day.DiveIndex is { } dayIndex)
                    {
                        <div class="day-index" data-index-band="@ForecastFormat.IndexBand(dayIndex)">@ForecastFormat.Number(dayIndex)</div>
                        <div class="day-bar" data-index-band="@ForecastFormat.IndexBand(dayIndex)" style="width: @(BarWidth(dayIndex))"></div>
                    }
                    else
                    {
                        <div class="day-index">–</div>
                    }
                    <div class="day-word">@DayWord(day)</div>
                </li>
            }
        </ol>
        @if (Forecast.HourList.Count > 0)
        {
            <section class="hourly" aria-labelledby="weather-heading">
                <h3 id="weather-heading" class="hourly-title">@L["Weather_Heading"]</h3>
                <WeatherChart Hours="Forecast.HourList" />
            </section>
        }
    </div>
</div>

<p class="sources">@Sources @(Forecast.ComputedAt is { } computed ? L["Computed", computed.ToLocalTime().ToString("dd.MM.yyyy HH:mm", CultureInfo.InvariantCulture)] : "")</p>

@code {
    [Parameter, EditorRequired]
    public SiteForecast Forecast { get; set; } = default!;

    /// <summary>Der Abfluss an einem Flussplatz, sonst <c>null</c>.</summary>
    [Parameter]
    public SiteDischarge? Discharge { get; set; }

    /// <summary>Der Verlauf bis heute für die Mini-Diagramme der Kacheln Sicht und Algen.</summary>
    [Parameter]
    public SiteIndexHistory? History { get; set; }

    private ForecastDay Today => Forecast.Days[0];

    private sealed record Trend(ChartSeries Series, IReadOnlyList<ChartTick> Markers, HistoryCharts.Range Range, string Aria);

    /// <summary>Der Verlauf des Index bis heute, klein neben der Zahl. Erst ab zwei Tagen mit Index, ohne Text.</summary>
    private Trend? IndexTrend
    {
        get
        {
            if (History is not { } history || history.Days.Count(d => d.SmoothedIndex is not null) < 2)
            {
                return null;
            }

            var range = HistoryCharts.RangeOf(history.Days, Today.Date);
            var series = new ChartSeries("index", L["Index_Label"], [.. history.Days.Select(d => new ChartPoint(range.X(d.Date), null, (double?)d.SmoothedIndex))], 0, 10);
            var markers = history.RuleChanges.Select(c => new ChartTick(range.X(c.Date), "")).ToList();
            return new Trend(series, markers, range, L["History_Aria", ForecastFormat.Date(range.From), ForecastFormat.Date(range.To)]);
        }
    }

    private static string ShortDate(DateOnly date) => date.ToString("dd.MM.", CultureInfo.InvariantCulture);

    private const int SparkDays = 30;

    /// <summary>Eine Lücke von mehr als 3 Tagen bricht die Linie ab.</summary>
    private double SparkGap => 3.0 / Math.Max(1, Today.Date.DayNumber - SparkFrom.DayNumber);

    private IEnumerable<HistoryDay> RecentDays => History?.Days.Where(d => d.Date >= SparkFrom) ?? [];

    /// <summary>Höchstens 30 Tage zurück. Gibt es erst wenige Tage, beginnt die Achse beim ersten Tag.</summary>
    private DateOnly SparkFrom
    {
        get
        {
            var earliest = Today.Date.AddDays(1 - SparkDays);
            return History?.Days.FirstOrDefault(d => d.Date >= earliest)?.Date ?? earliest;
        }
    }

    private string SparkCaption => SparkFrom > Today.Date.AddDays(1 - SparkDays)
        ? L["Spark_Since", SparkFrom.ToString("dd.MM.", CultureInfo.InvariantCulture)]
        : L["Spark_Past30"];

    private double SparkX(DateOnly date) =>
        SparkFrom >= Today.Date ? 1 : (double)(date.DayNumber - SparkFrom.DayNumber) / (Today.Date.DayNumber - SparkFrom.DayNumber);

    private ChartSeries VisibilitySpark => new(
        "visibility", L["History_Visibility"],
        [.. RecentDays.Select(d => new ChartPoint(SparkX(d.Date), null, (double?)d.SecchiDepthShore))],
        0, HistoryCharts.VisibilityMax(RecentDays.Select(d => d.SecchiDepthShore)));

    private ChartSeries AlgaeSpark => new(
        "index", L["Tile_Algae"],
        [.. RecentDays.Select(d => new ChartPoint(SparkX(d.Date), null, HistoryCharts.Algae(d.AlgaeLevel)))],
        1, 3);

    /// <summary>Der stärkste Wind pro Prognosetag, mindestens bis 30 km/h skaliert.</summary>
    private ChartSeries WindSpark => new(
        "wind", L["Tile_Wind"],
        [.. Forecast.Days.Select((d, i) => new ChartPoint(Forecast.Days.Count == 1 ? 1 : (double)i / (Forecast.Days.Count - 1), (double?)d.WindSpeedKmh, (double?)d.WindSpeedKmh))],
        0, Math.Max(30, (double)(Forecast.Days.Max(d => d.WindSpeedKmh) ?? 0)));

    private string Eyebrow => Today.ProfileSource is { } source ? L[$"Profile_Source_{source}"] : L["Day_Outlook"];

    private string ProfileNote => Today is { ThermoclineTop: { } top, ThermoclineBottom: { } bottom }
        ? L["Profile_Thermocline", ForecastFormat.Meters(top), ForecastFormat.Meters(bottom)]
        : L["Profile_Mixed"];

    private MarkupString Sources => Forecast.HasSatellite
        ? SourceLinks.Format(L["Sources"], SourceLinks.Alplakes(L), SourceLinks.MeteoSwiss(L), SourceLinks.OpenMeteo(L), SourceLinks.Bafu(L))
        : SourceLinks.Format(L["Sources_River"], SourceLinks.MeteoSwiss(L), SourceLinks.OpenMeteo(L), SourceLinks.Bafu(L));

    private string VisibilityNote => Today switch
    {
        _ when !Forecast.HasSatellite => L["Visibility_River"],
        { ClaritySource: ClaritySource.Sentinel2Shore, SecchiDepthShore: { } nearShore, SecchiObservedAt: { } shoreDate } =>
            L["Visibility_Sentinel2Shore", ForecastFormat.Date(shoreDate), ForecastFormat.Number(nearShore)]
            + (Today.VisibilityGoodBelow is { } shoreBelow ? $" · {L["Visibility_GoodBelow", ForecastFormat.Meters(shoreBelow)]}" : ""),
        { SecchiDepth: { } depth, SecchiDepthShore: { } shore, SecchiObservedAt: { } date } =>
            L["Visibility_SatelliteShore", ForecastFormat.Date(date), ForecastFormat.Number(depth), ForecastFormat.Number(shore)]
            + (Today.VisibilityGoodBelow is { } goodBelow ? $" · {L["Visibility_GoodBelow", ForecastFormat.Meters(goodBelow)]}" : ""),
        { SecchiDepth: { } depth, SecchiObservedAt: { } date } => L["Visibility_Satellite", ForecastFormat.Date(date), ForecastFormat.Number(depth)]
            + (Today.VisibilityGoodBelow is { } below ? $" · {L["Visibility_GoodBelow", ForecastFormat.Meters(below)]}" : ""),
        { SecchiObservedAt: { } old } => L["Visibility_SatelliteOld", ForecastFormat.Date(old)],
        _ => L["Visibility_NoSatellite"],
    };

    private string DayWord(ForecastDay day) => day.IsOutlook
        ? L["Day_Outlook"]
        : day.Reasons.Count > 0 ? L[$"Reason_{day.Reasons[0]}"] : "";

    private static string BarWidth(decimal index) => FormattableString.Invariant($"{Math.Clamp(index * 10, 10, 100):0}%");
}
