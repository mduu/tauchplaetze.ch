@page "/platform/queues"
@layout PlatformLayout
@attribute [Authorize(Roles = Roles.Admin)]
@inherits AdminPage
@using Microsoft.AspNetCore.Authorization
@using Tauchplaetze.Core.Features.Accounts
@using Tauchplaetze.Core.Features.Mail
@using Tauchplaetze.Core.Features.Mail.Commands
@using Tauchplaetze.Core.Features.Mail.Queries
@using Tauchplaetze.Web.Features.Editorial
@inject IDialogService Dialogs

<div class="d-flex align-center justify-space-between flex-wrap gap-2 mb-4">
    <MudText Typo="Typo.h4">@L["Platform_Queues_Title"]</MudText>
    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" OnClick="Load" Disabled="busy">@L["Platform_Refresh"]</MudButton>
</div>
<MudText Typo="Typo.body2" Class="mb-4">@L["Platform_Queues_Lead"]</MudText>

@if (message is not null)
{
    <MudAlert Severity="Severity.Info" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="@(() => message = null)">@message</MudAlert>
}

@if (status is null && busy)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (status is null)
{
    <MudAlert Severity="Severity.Warning" data-no-data>@L["Platform_NoData"]</MudAlert>
}
else
{
    <MudGrid Class="mb-4">
        <MudItem xs="12" sm="6">
            <MudPaper Outlined="true" Class="pa-4">
                <MudText Typo="Typo.overline">@L["Platform_Waiting"]</MudText>
                <MudText Typo="Typo.h3" data-count="waiting">@status.Waiting</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudPaper Outlined="true" Class="@($"pa-4 {(status.DeadLetters > 0 ? "platform-alert" : "")}")">
                <MudText Typo="Typo.overline">@L["Platform_DeadLetters"]</MudText>
                <MudText Typo="Typo.h3" data-count="deadletters">@status.DeadLetters</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    @if (status.DeadLetters > 0)
    {
        <MudStack Row="true" Class="mb-3" Wrap="Wrap.Wrap">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => Replay(null))" Disabled="busy">@L["Platform_ReplayAll"]</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="@(() => Delete(null))" Disabled="busy">@L["Platform_DeleteAll"]</MudButton>
        </MudStack>
    }

    @if (status.Items.Count == 0)
    {
        <MudText Typo="Typo.body1">@L["Platform_NoDeadLetters"]</MudText>
    }
    else
    {
        <MudText Typo="Typo.caption" Class="mb-2 d-block">@L["Platform_PeekLimit"] @L["Platform_ReplayHint"]</MudText>
        <MudExpansionPanels MultiExpansion="true">
            @foreach (var item in status.Items)
            {
                <MudExpansionPanel Text="@Title(item)">
                    <MudSimpleTable Dense="true">
                        <tbody>
                            <tr><th>@L["Platform_To"]</th><td>@(item.To ?? "–")</td></tr>
                            <tr><th>@L["Platform_Template"]</th><td>@(item.Template ?? "–")</td></tr>
                            <tr><th>@L["Platform_Attempts"]</th><td>@item.Attempts</td></tr>
                            <tr><th>@L["Platform_Reason"]</th><td class="platform-reason">@(item.Unreadable ? L["Platform_Unreadable"] : item.Reason ?? "–")</td></tr>
                            <tr><th>@L["Platform_FailedAt"]</th><td>@(item.FailedAt is { } failed ? SwissClock.DateTime(failed) : "–")</td></tr>
                            <tr><th>@L["Platform_CreatedAt"]</th><td>@(item.CreatedAt is { } created ? SwissClock.DateTime(created) : "–")</td></tr>
                            <tr><th>@L["Platform_MessageId"]</th><td><code>@item.MessageId</code></td></tr>
                        </tbody>
                    </MudSimpleTable>
                    @if (item.MessageId is { } id)
                    {
                        <MudStack Row="true" Class="mt-3">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="@(() => Replay(id))" Disabled="busy">@L["Platform_Replay"]</MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" OnClick="@(() => Delete(id))" Disabled="busy">@L["Platform_Delete"]</MudButton>
                        </MudStack>
                    }
                </MudExpansionPanel>
            }
        </MudExpansionPanels>
    }
}

@code {
    private MailQueueStatus? status;

    private string? message;

    private bool busy = true;

    protected override async Task Load()
    {
        busy = true;
        status = await Query<GetMailQueueStatusQuery, MailQueueStatus?>(new GetMailQueueStatusQuery(UserId));
        busy = false;
    }

    private string Title(DeadLetterItem item) => item.Unreadable
        ? L["Platform_Unreadable"]
        : $"{item.Subject ?? item.Template} · {item.To ?? "–"} · {(item.FailedAt is { } failed ? SwissClock.DateTime(failed) : "–")}";

    private async Task Replay(Guid? id)
    {
        busy = true;
        var result = await Command<ReplayDeadLettersCommand, DeadLetterActionResult>(new ReplayDeadLettersCommand(UserId, id));
        message = L["Platform_Replayed", result.Count];
        await Load();
    }

    private async Task Delete(Guid? id)
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            L[id is null ? "Platform_DeleteAll_Title" : "Platform_Delete_Title"],
            L["Platform_Delete_Text"],
            yesText: L["Platform_Delete"], cancelText: L["Platform_Cancel"]);
        if (confirmed != true)
        {
            return;
        }

        busy = true;
        var result = await Command<DeleteDeadLettersCommand, DeadLetterActionResult>(new DeleteDeadLettersCommand(UserId, id));
        message = L["Platform_Deleted", result.Count];
        await Load();
    }
}
