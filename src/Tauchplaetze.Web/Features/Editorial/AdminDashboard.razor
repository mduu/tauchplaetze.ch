@page "/admin"
@layout AdminLayout
@attribute [Authorize(Roles = "Moderator,Admin")]
@inherits AdminPage
@using Microsoft.AspNetCore.Authorization
@using Tauchplaetze.Core.Features.Editorial.Queries

<MudText Typo="Typo.h4" GutterBottom="true">@L["Dashboard_Welcome", User.Identity?.Name ?? ""]</MudText>

<MudGrid>
    <MudItem xs="12" sm="4">
        <MudPaper Class="pa-4" Outlined="true">
            <MudText Typo="Typo.overline">@L["Dashboard_Sites"]</MudText>
            <MudText Typo="Typo.h4">@sites</MudText>
            <MudLink Href="/admin/plaetze">@L["Nav_Sites"] →</MudLink>
        </MudPaper>
    </MudItem>
    @if (IsModerator)
    {
        <MudItem xs="12" sm="4">
            <MudPaper Class="pa-4" Outlined="true">
                <MudText Typo="Typo.overline">@L["Dashboard_Pending"]</MudText>
                <MudText Typo="Typo.h4" Color="@(pending > 0 ? Color.Secondary : Color.Default)">@pending</MudText>
                <MudLink Href="/admin/vorschlaege">@L["Nav_Pending"] →</MudLink>
            </MudPaper>
        </MudItem>
    }
</MudGrid>

@code {
    private int sites;

    private int pending;

    protected override async Task Load()
    {
        sites = (await Query<GetDiveSitesForEditingQuery, IReadOnlyList<EditableDiveSite>>(new GetDiveSitesForEditingQuery())).Count;
        if (IsModerator)
        {
            pending = (await Query<GetPendingRevisionsQuery, IReadOnlyList<PendingRevision>>(new GetPendingRevisionsQuery(UserId))).Count;
        }
    }
}
