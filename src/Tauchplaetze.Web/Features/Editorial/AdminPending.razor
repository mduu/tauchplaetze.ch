@page "/admin/vorschlaege"
@layout AdminLayout
@attribute [Authorize(Roles = "Moderator,Admin")]
@inherits AdminPage
@using Microsoft.AspNetCore.Authorization
@using Tauchplaetze.Core.Features.Editorial
@using Tauchplaetze.Core.Features.Editorial.Commands
@using Tauchplaetze.Core.Features.Editorial.Queries
@inject NavigationManager Navigation

<MudText Typo="Typo.h4" Class="mb-4">@L["Pending_Title"]</MudText>
<ErrorList Errors="errors" />

@if (pending.Count == 0)
{
    <MudText>@L["Pending_None"]</MudText>
}

<MudStack Spacing="4">
    @foreach (var item in pending)
    {
        <MudPaper Outlined="true" Class="pa-4">
            <MudText Typo="Typo.h6"><MudLink Href="@($"/admin/plaetze/{item.DiveSiteId}")">@item.SiteName</MudLink></MudText>
            <MudText Typo="Typo.body2" Class="mb-2">
                @L["Pending_By", item.Revision.Number, item.Revision.AuthorName ?? L["Versions_DeletedAccount"], item.Revision.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm", CultureInfo.InvariantCulture)]
                · «@(item.Revision.Comment ?? L["Comment_None"])»
            </MudText>
            @if (item.BaseIsOutdated)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2">@L["Pending_Outdated"]</MudAlert>
            }
            <MudText Typo="Typo.subtitle2">@L["Pending_Changes"]</MudText>
            <DiffTable Changes="@changes.GetValueOrDefault(item.Revision.Id)" />
            <MudStack Row="true" Class="mt-3" AlignItems="AlignItems.End">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => Approve(item))">@L["Pending_Approve"]</MudButton>
                <MudTextField @bind-Value="reasons[item.Revision.Id]" Label="@L["Pending_Reason"]" MaxLength="500" />
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="@(() => Reject(item))">@L["Pending_Reject"]</MudButton>
            </MudStack>
        </MudPaper>
    }
</MudStack>

@code {
    private IReadOnlyList<PendingRevision> pending = [];

    private readonly Dictionary<Guid, IReadOnlyList<FieldChange>?> changes = [];

    private readonly Dictionary<Guid, string> reasons = [];

    private IReadOnlyList<EditorialError> errors = [];

    protected override async Task Load()
    {
        pending = await Query<GetPendingRevisionsQuery, IReadOnlyList<PendingRevision>>(new GetPendingRevisionsQuery());
        foreach (var item in pending)
        {
            reasons.TryAdd(item.Revision.Id, "");
            changes[item.Revision.Id] = await Query<CompareRevisionsQuery, IReadOnlyList<FieldChange>?>(new CompareRevisionsQuery(item.DiveSiteId, item.Revision.BaseNumber, item.Revision.Number));
        }
    }

    private async Task Approve(PendingRevision item)
    {
        var result = await Command<ApproveRevisionCommand, EditorialResult>(new ApproveRevisionCommand(UserId, item.Revision.Id, Navigation.BaseUri));
        errors = result.Errors;
        await Load();
    }

    private async Task Reject(PendingRevision item)
    {
        var result = await Command<RejectRevisionCommand, EditorialResult>(new RejectRevisionCommand(UserId, item.Revision.Id, reasons[item.Revision.Id]));
        errors = result.Errors;
        await Load();
    }
}
