@page "/admin/prognose"
@layout AdminLayout
@attribute [Authorize(Roles = "Moderator,Admin")]
@inherits AdminPage
@using Microsoft.AspNetCore.Authorization
@using Tauchplaetze.Core.Features.Forecasts.Commands
@using Tauchplaetze.Core.Features.Forecasts.Queries

<div class="d-flex align-center justify-space-between mb-4">
    <MudText Typo="Typo.h4">@L["Forecast_Title"]</MudText>
    @if (IsAdmin)
    {
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="RunNow" Disabled="running">@L["Forecast_RunNow"]</MudButton>
    }
</div>
@if (running)
{
    <MudAlert Severity="Severity.Info" Class="mb-4">@L["Forecast_Running"]</MudAlert>
    <MudProgressLinear Indeterminate="true" Class="mb-4" />
}

@if (notAllowed)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@L["Error_NotAllowed"]</MudAlert>
}

@if (skipped)
{
    <MudAlert Severity="Severity.Warning" Class="mb-4">@L["Forecast_Skipped"]</MudAlert>
}

<MudStack Spacing="3">
    @foreach (var run in runs)
    {
        <MudPaper Outlined="true" Class="pa-4">
            <MudText Typo="Typo.h6">@SwissClock.DateTime(run.StartedAt) · @L[$"RunStatus_{run.Status}"]</MudText>
            <MudText Typo="Typo.body2">@L["Forecast_Calls", run.Calls]</MudText>
            @if (run.Failures.Count > 0)
            {
                <MudText Typo="Typo.subtitle2" Class="mt-2">@L["Forecast_Failures"]</MudText>
                @foreach (var failure in run.Failures)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@failure</MudText>
                }
            }
        </MudPaper>
    }
</MudStack>

@code {
    private IReadOnlyList<ForecastRunSummary> runs = [];

    private bool running;

    private bool skipped;

    private bool notAllowed;

    protected override async Task Load() =>
        runs = await Query<GetForecastRunsQuery, IReadOnlyList<ForecastRunSummary>>(new GetForecastRunsQuery());

    private async Task RunNow()
    {
        running = true;
        var result = await Command<StartForecastRunCommand, StartForecastRunResult>(new StartForecastRunCommand(UserId));
        notAllowed = !result.Allowed;
        skipped = result.Run?.Skipped ?? false;
        running = false;
        await Load();
    }
}
