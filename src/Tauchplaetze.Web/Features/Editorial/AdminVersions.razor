@page "/admin/plaetze/{Id:guid}/versionen"
@layout AdminLayout
@attribute [Authorize(Roles = "Moderator,Admin")]
@inherits AdminPage
@using Microsoft.AspNetCore.Authorization
@using Tauchplaetze.Core.Features.Media.Queries
@using Tauchplaetze.Web.Features.Media
@using Tauchplaetze.Core.Features.Editorial
@using Tauchplaetze.Core.Features.Editorial.Commands
@using Tauchplaetze.Core.Features.Editorial.Queries

<MudText Typo="Typo.h4" Class="mb-4">@L["Versions_Title", name]</MudText>
<ErrorList Errors="errors" />

<MudStack Spacing="3">
    @foreach (var revision in revisions)
    {
        <MudPaper Outlined="true" Class="pa-4">
            <div class="d-flex justify-space-between flex-wrap gap-2">
                <div>
                    <MudText Typo="Typo.h6">#@revision.Number · @L[$"Revision_{revision.Status}"]</MudText>
                    <MudText Typo="Typo.body2">
                        @L["Versions_Author"]: @(revision.AuthorName ?? L["Versions_DeletedAccount"]) · @SwissClock.DateTime(revision.CreatedAt)
                        @if (revision.ReviewedAt is { } reviewed)
                        {
                            <span> · @L["Versions_Reviewer"]: @(revision.ReviewerName ?? L["Versions_DeletedAccount"]), @SwissClock.DateTime(reviewed)</span>
                        }
                    </MudText>
                    <MudText Typo="Typo.body2">«@(revision.Comment ?? L["Comment_None"])»</MudText>
                    @if (revision.ReviewComment is not null)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@revision.ReviewComment</MudText>
                    }
                </div>
                <MudStack Row="true">
                    <MudButton Variant="Variant.Text" OnClick="@(() => Compare(revision.Number))">@L["Versions_CompareBase"]</MudButton>
                    @if (IsModerator && revision.Number != revisions[0].Number)
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Disabled="busy" OnClick="@(() => Restore(revision.Number))">@L["Versions_Restore"]</MudButton>
                    }
                </MudStack>
            </div>
            @if (comparing == revision.Number)
            {
                <div class="mt-3"><DiffTable Changes="changes" /><RevisionPhotos Photos="photos" /></div>
            }
        </MudPaper>
    }
</MudStack>

@code {
    private IReadOnlyList<RevisionSummary> revisions = [];

    private IReadOnlyList<FieldChange>? changes;

    private IReadOnlyList<RevisionPhoto> photos = [];

    private IReadOnlyList<EditorialError> errors = [];

    private int? comparing;

    private bool busy;

    private string name = "";

    [Parameter]
    public Guid Id { get; set; }

    protected override async Task Load()
    {
        revisions = await Query<GetRevisionsQuery, IReadOnlyList<RevisionSummary>>(new GetRevisionsQuery(Id, UserId));
        name = (await Query<GetDiveSiteForEditingQuery, DiveSiteForEditing?>(new GetDiveSiteForEditingQuery(Id)))?.Content.Name ?? "";
    }

    private async Task Compare(int number)
    {
        comparing = number;
        var revision = revisions.Single(r => r.Number == number);
        changes = await Query<CompareRevisionsQuery, IReadOnlyList<FieldChange>?>(new CompareRevisionsQuery(Id, revision.BaseNumber, number, UserId));
        photos = await Query<CompareRevisionMediaQuery, IReadOnlyList<RevisionPhoto>>(new CompareRevisionMediaQuery(UserId, Id, revision.BaseNumber, number, MediaEndpoints.PendingPathTemplate));
    }

    private async Task Restore(int number)
    {
        if (busy)
        {
            return;
        }

        busy = true;
        var result = await Command<RestoreRevisionCommand, EditorialResult>(new RestoreRevisionCommand(UserId, Id, number));
        errors = result.Errors;
        await Load();
        busy = false;
    }
}
