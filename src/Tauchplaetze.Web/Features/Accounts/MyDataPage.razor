@page "/{Lang}/account/my-data"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Tauchplaetze.Core.CrossCutting.UseCases
@using Tauchplaetze.Core.Features.Accounts.Queries
@using Tauchplaetze.Web.Features.Editorial
@using Tauchplaetze.Web.Features.Reports
@inject IQueryHandler<GetPersonalDataQuery, PersonalData?> PersonalDataQuery
@inject IStringLocalizer<AccountStrings> L

<AccountLayout Title="@L["MyData_Title"]" Lead="@L["MyData_Lead"]">
    <AccountNav />
    @if (data is not null)
    {
        <h2 class="subtitle">@L["MyData_Account"]</h2>
        <dl class="facts">
            <dt>@L["Email"]</dt><dd>@data.Email</dd>
            <dt>@L["DisplayName"]</dt><dd>@data.DisplayName</dd>
            <dt>@L["MyData_PublicName"]</dt><dd>@(data.ShowNamePublicly ? L["Yes"] : L["No"])</dd>
            <dt>@L["Language"]</dt><dd>@data.PreferredCulture</dd>
            <dt>@L["MyData_Roles"]</dt><dd>@string.Join(", ", data.Roles)</dd>
            <dt>@L["MyData_Confirmed"]</dt><dd>@(data.EmailConfirmed ? L["Yes"] : L["No"])</dd>
            <dt>@L["MyData_CreatedAt"]</dt><dd>@(data.CreatedAt is { } created ? SwissClock.DateTime(created) : "–")</dd>
            <dt>@L["MyData_LastSignInAt"]</dt><dd>@(data.LastSignInAt is { } last ? SwissClock.DateTime(last) : "–")</dd>
        </dl>

        <h2 class="subtitle">@L["MyData_Contributions"]</h2>
        <RevisionReferences Items="data.Contributions" />

        <h2 class="subtitle">@L["MyData_Reviews"]</h2>
        <RevisionReferences Items="data.Reviews" />

        <h2 class="subtitle">@L["MyData_Photos"]</h2>
        @if (data.PhotoList.Count == 0)
        {
            <p>@L["MyData_None"]</p>
        }
        else
        {
            <ul class="references">
                @foreach (var photo in data.PhotoList)
                {
                    <li>
                        <a href="@PublicRoutes.DiveSite(Language, photo.SiteSlug)">@photo.SiteName</a>
                        · @photo.Photographer · @photo.UploadedAt.ToString("dd.MM.yyyy", CultureInfo.InvariantCulture)
                        · @(photo.IsPublic ? L["MyData_PhotoPublic"] : L["MyData_PhotoPrivate"])
                    </li>
                }
            </ul>
        }

        <h2 class="subtitle">@L["MyData_Reports"]</h2>
        @if (data.ReportList.Count == 0)
        {
            <p>@L["MyData_None"]</p>
        }
        else
        {
            <ul class="references" data-my-reports>
                @foreach (var report in data.ReportList)
                {
                    <li>
                        <a href="@PublicRoutes.DiveSite(Language, report.SiteSlug)">@report.SiteName</a>
                        · @ReportFormat.Date(report.Date) · @L["MyData_ReportVisibility", ReportFormat.Metres(report.Visibility)]
                        @if (report.Comment is { } comment)
                        {
                            <span> · «@comment»</span>
                        }
                        @if (report.IsHidden)
                        {
                            <span> · @L["MyData_ReportHidden"]</span>
                        }
                    </li>
                }
            </ul>
        }

        <p><a class="button" href="/@Language/account/my-data.json" download>@L["MyData_Download"]</a></p>
    }
</AccountLayout>

@code {
    private PersonalData? data;

    [Parameter]
    public string? Lang { get; set; }

    [CascadingParameter]
    public HttpContext HttpContext { get; set; } = default!;

    private static string Language => CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;

    protected override async Task OnInitializedAsync() =>
        data = await PersonalDataQuery.Handle(new GetPersonalDataQuery(AccountCookie.UserId(HttpContext.User)!));
}
