@page "/{Lang}/account/reset-password"
@attribute [Microsoft.AspNetCore.RateLimiting.EnableRateLimiting(AccountFormsRateLimit.Policy)]
@using Tauchplaetze.Core.CrossCutting.UseCases
@using Tauchplaetze.Core.Features.Accounts
@using Tauchplaetze.Core.Features.Accounts.Commands
@inject ICommandHandler<ResetPasswordCommand, AccountResult> Reset
@inject IStringLocalizer<AccountStrings> L

<AccountLayout Title="@L["Reset_Title"]" Messages="messages" IsError="@(!succeeded)">
    @if (succeeded)
    {
        <p><a class="button" href="@AccountPaths.SignIn(Language)">@L["SignIn_Submit"]</a></p>
    }
    else
    {
        <EditForm Model="Input" FormName="reset" OnSubmit="Submit" class="form">
            <label>@L["Password"] <InputText type="password" autocomplete="new-password" required minlength="10" @bind-Value="Input!.Password" /></label>
            <p class="help">@L["Password_Help"]</p>
            <button type="submit" class="button">@L["Reset_Submit"]</button>
        </EditForm>
    }
</AccountLayout>

@code {
    private IReadOnlyList<string> messages = [];

    private bool succeeded;

    [Parameter]
    public string? Lang { get; set; }

    [SupplyParameterFromQuery(Name = "limit")]
    public string? Limit { get; set; }

    [SupplyParameterFromQuery(Name = "user")]
    public string? UserId { get; set; }

    [SupplyParameterFromQuery]
    public string? Token { get; set; }

    [SupplyParameterFromForm]
    private ResetInput? Input { get; set; }

    protected override void OnInitialized()
    {
        Input ??= new ResetInput();
        if (Limit is not null)
        {
            messages = [L["Account_Limit"]];
        }
    }

    private static string Language => CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;

    private async Task Submit()
    {
        var result = await Reset.Handle(new ResetPasswordCommand(UserId ?? "", Token ?? "", Input!.Password));
        succeeded = result.Succeeded;
        messages = succeeded ? [L["Reset_Done"]] : AccountText.Errors(L, result);
    }

    private sealed class ResetInput
    {
        public string Password { get; set; } = "";
    }
}
