@page "/{Lang}/account/forgot-password"
@using Tauchplaetze.Core.CrossCutting.UseCases
@using Tauchplaetze.Core.Features.Accounts.Commands
@inject ICommandHandler<RequestPasswordResetCommand, Unit> RequestReset
@inject IStringLocalizer<AccountStrings> L

<AccountLayout Title="@L["Forgot_Title"]" Lead="@L["Forgot_Lead"]" Messages="messages">
    @if (messages.Count == 0)
    {
        <EditForm Model="Input" FormName="forgot" OnSubmit="Submit" class="form">
            <label>@L["Email"] <InputText type="email" autocomplete="email" required @bind-Value="Input!.Email" /></label>
            <button type="submit" class="button">@L["Forgot_Submit"]</button>
        </EditForm>
    }
</AccountLayout>

@code {
    private IReadOnlyList<string> messages = [];

    [Parameter]
    public string? Lang { get; set; }

    [SupplyParameterFromForm]
    private ForgotInput? Input { get; set; }

    protected override void OnInitialized() => Input ??= new ForgotInput();

    private static string Language => CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;

    private async Task Submit()
    {
        await RequestReset.Handle(new RequestPasswordResetCommand(Input!.Email, AccountPaths.ResetTemplate(Language)));
        messages = [L["Forgot_Done"]];
    }

    private sealed class ForgotInput
    {
        public string Email { get; set; } = "";
    }
}
