@* Löschen in zwei Schritten: der erste Klick fragt nach, der zweite löscht. Ohne Browser-Dialog. *@
@using Tauchplaetze.Core.Features.Media
@inject IStringLocalizer<AdminStrings> L

@if (asking)
{
    <span class="delete-confirm" role="group" aria-label="@L["Media_DeleteTitle"]">
        <span>@L["Media_DeleteConfirm"]</span>
        <button type="button" class="link-button danger" @ref="confirmButton" @onclick="Confirm">@L["Media_Delete"]</button>
        <button type="button" class="link-button" @onclick="() => asking = false">@L["Sketch_Cancel"]</button>
    </span>
}
else
{
    <button type="button" class="link-button danger" @onclick="Ask">@L["Media_Delete"]</button>
}

@code {
    private bool asking;

    private bool focusConfirm;

    private ElementReference confirmButton;

    [Parameter, EditorRequired]
    public SiteMediaItem Item { get; set; } = default!;

    [Parameter]
    public EventCallback<SiteMediaItem> Confirmed { get; set; }

    private void Ask() => (asking, focusConfirm) = (true, true);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusConfirm)
        {
            focusConfirm = false;
            await confirmButton.FocusAsync();
        }
    }

    private async Task Confirm()
    {
        asking = false;
        await Confirmed.InvokeAsync(Item);
    }
}
