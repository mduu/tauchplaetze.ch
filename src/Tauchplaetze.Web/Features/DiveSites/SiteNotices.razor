@using System.Globalization
@using Tauchplaetze.Core.Features.DiveSites
@using Tauchplaetze.Core.Features.Forecasts
@using Tauchplaetze.Web.Features.Forecasts
@inject IStringLocalizer<DiveSiteStrings> L
@inject IStringLocalizer<ForecastStrings> F
@inject TimeProvider Time

@if (Today.Count > 0 || Soon.Count > 0 || ShownDeviation is not null)
{
    <section class="page-section notices" aria-label="@L["Notices_Label"]">
        @foreach (var notice in Today)
        {
            <div class="notice" data-notice-kind="@notice.Kind.ToString().ToLowerInvariant()" data-notice-source="@(notice.Susv is null ? "editorial" : "susv")">
                <div class="notice-head">
                    <p class="notice-kind">
                        @L[$"Notice_{notice.Kind}"]
                        @if (NoticeLabels.Today(notice, L) is { } until)
                        {
                            <span class="notice-until">· @until</span>
                        }
                    </p>
                    @if (notice.Susv is { } susv)
                    {
                        <SusvBadge Url="@susv.DetailUrl" />
                    }
                </div>
                @if (notice.Susv is { } source)
                {
                    <p class="notice-title" lang="@(notice.GermanOnly ? "de" : null)">@source.Title</p>
                }
                <p class="notice-text" lang="@(notice.GermanOnly ? "de" : null)">@notice.Text</p>
                @if (notice.MachineTranslated)
                {
                    <p class="notice-source" data-machine-translated>@L["Text_MachineTranslated"]</p>
                }
            </div>
        }
        @foreach (var notice in Soon)
        {
            <details class="notice-soon" data-notice-kind="@notice.Kind.ToString().ToLowerInvariant()" data-notice-timing="soon">
                <summary>
                    <span class="notice-kind">@L[$"Notice_{notice.Kind}"]</span>
                    <span class="notice-until">@NoticeLabels.Period(notice, L)</span>
                    @if (notice.Susv is { } susv)
                    {
                        <span class="notice-soon-title" lang="@(notice.GermanOnly ? "de" : null)">@susv.Title</span>
                    }
                </summary>
                <p class="notice-text" lang="@(notice.GermanOnly ? "de" : null)">@notice.Text</p>
                @if (notice.MachineTranslated)
                {
                    <p class="notice-source" data-machine-translated>@L["Text_MachineTranslated"]</p>
                }
                @if (notice.Susv is { } source)
                {
                    <SusvBadge Url="@source.DetailUrl" />
                }
            </details>
        }
        @if (LakeLevel is { Deviation: { } deviation } level)
        {
            <div class="measured-notice" data-lake-level="@deviation">
                <svg class="measured-icon" viewBox="0 0 40 40" aria-hidden="true">
                    <rect x="11" y="5" width="8" height="30" rx="2" class="gauge" />
                    <path d="M11 10h4M11 15h6M11 20h4M11 25h6M11 30h4" class="gauge-ticks" />
                    <path d="@(deviation == LakeLevelDeviation.VeryLow ? "M5 27 q3 -2 6 0 t6 0 t6 0" : "M5 13 q3 -2 6 0 t6 0 t6 0")" class="gauge-water" />
                    <path d="@(deviation == LakeLevelDeviation.VeryLow ? "M30 10v16m-5 -5l5 5l5 -5" : "M30 30v-16m-5 5l5 -5l5 5")" class="gauge-arrow" />
                </svg>
                <div class="measured-body">
                    <p class="notice-kind">
                        @L[$"LakeLevel_{deviation}_Title"]
                        <span class="measured-badge">@L["LakeLevel_Badge"]</span>
                    </p>
                    <p class="notice-text">@L[$"LakeLevel_{deviation}_Text", level.Level.ToString("0.00", CultureInfo.CurrentCulture), Centimetres(level.FromMedian)]</p>
                    <p class="notice-source">
                        @SourceLinks.Format(F["Discharge_Source"], SourceLinks.Bafu(F))
                        · @F["Discharge_Station", level.StationName, DischargeFormat.Time(level.MeasuredAt, Time)]
                    </p>
                </div>
            </div>
        }
    </section>
}

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<SiteNotice> Notices { get; set; } = [];

    private List<SiteNotice> Today => [.. Notices.Where(n => n.Timing == NoticeTiming.Today)];

    private List<SiteNotice> Soon => [.. Notices.Where(n => n.Timing == NoticeTiming.Soon)];

    /// <summary>Der Pegel am See. Ein Hinweis erscheint nur ausserhalb des üblichen Bereichs.</summary>
    [Parameter]
    public SiteLakeLevel? LakeLevel { get; set; }

    private LakeLevelDeviation? ShownDeviation => LakeLevel?.Deviation;

    private static string Centimetres(decimal metres) => Math.Round(Math.Abs(metres) * 100).ToString("0", CultureInfo.CurrentCulture);
}
