@page "/de/tauchplaetze/{Slug}"
@page "/en/dive-sites/{Slug}"
@page "/fr/sites-de-plongee/{Slug}"
@page "/it/siti-di-immersione/{Slug}"
@using Tauchplaetze.Core.CrossCutting.UseCases
@using Tauchplaetze.Core.Features.DiveSites
@using Tauchplaetze.Core.Features.DiveSites.Queries
@using Tauchplaetze.Core.Features.Forecasts
@using Tauchplaetze.Core.Features.Forecasts.Queries
@using Tauchplaetze.Web.Features.Forecasts
@inject IQueryHandler<GetDiveSiteQuery, DiveSiteLookup> DiveSites
@inject IQueryHandler<GetSiteForecastQuery, SiteForecast> Forecasts
@inject IStringLocalizer<SharedStrings> Shared
@inject IStringLocalizer<DiveSiteStrings> L
@inject NavigationManager Navigation

@switch (lookup)
{
    case DiveSiteLookup.Found { Site: var site }:
        <PageTitle>@site.Name · @site.WaterBodyName · @Shared["Brand"]</PageTitle>
        <HeadContent>
            <meta name="description" content="@L["MetaDescription", site.Name, site.WaterBodyName]" />
            <HreflangLinks />
        </HeadContent>

        <UnderwaterHero Photo="site.Hero" Credit="@(site.Hero is { } hero ? L["Hero_Credit", hero.Photographer].Value : null)">
            <nav aria-label="@L["Breadcrumb"]">
                <ol class="breadcrumb">
                    <li>@site.WaterBodyName</li>
                    @if (site.Municipality is not null)
                    {
                        <li>@site.Municipality @site.Canton</li>
                    }
                </ol>
            </nav>
            <h1 class="site-name">@site.Name</h1>
            @if (site.OtherNameList.Count > 0)
            {
                <p class="other-names">@L["Site_OtherNames", string.Join(", ", site.OtherNameList)]</p>
            }
        </UnderwaterHero>

        @if (Saved is "vorschlag" or "online")
        {
            <p class="saved-banner" role="status" data-saved="@Saved">@L[Saved == "online" ? "EditMode_Saved_Approved" : "EditMode_Saved_Pending"]</p>
        }
        <SiteNotices Notices="site.Notices" />

        <section class="page-section" aria-labelledby="conditions">
            @if (forecast is { Days.Count: > 0 })
            {
                <ForecastPanel Forecast="forecast" />
            }
            else
            {
                <p class="eyebrow">@L["Conditions_Eyebrow"]</p>
                <h2 id="conditions" class="section-title">@L["Conditions_Soon_Title"]</h2>
                <div class="card pending">
                    <p>@L["Conditions_Soon_Text"]</p>
                </div>
            }
        </section>

        <SiteLocationMap Site="site" />

        <SiteRatingsBlock Ratings="site.Ratings" />

        <SitePhotos Photos="site.PhotoList" />

        <section class="page-section" aria-labelledby="practical">
            <h2 id="practical" class="practical-title">@L["Practical"]</h2>
            <div class="tiles">
                <div class="tile">
                    <div class="tile-label">@L["Coordinates"]</div>
                    <p data-coordinates>@Coordinates(site)</p>
                    <p><a href="@MapLink(site)" rel="noopener" target="_blank">@L["Map_Open"]</a></p>
                </div>
                <div class="tile">
                    <div class="tile-label">@L["Navigate"]</div>
                    <ul class="route-links">
                        <li><a href="@GoogleRoute(site)" rel="noopener" target="_blank" data-route="google">@L["Navigate_Google"]</a></li>
                        <li><a href="@AppleRoute(site)" rel="noopener" target="_blank" data-route="apple">@L["Navigate_Apple"]</a></li>
                    </ul>
                </div>
                <div class="tile">
                    <div class="tile-label">@L["Emergency"]</div>
                    <ul class="emergency-numbers">
                        <li><a href="tel:144">@L["Emergency_Ambulance"] 144</a></li>
                        <li><a href="tel:1414">Rega 1414</a></li>
                        <li><a href="tel:117">@L["Emergency_Police"] 117</a></li>
                        <li><a href="tel:+390642115685">DAN Europe +39 06 4211 5685</a></li>
                    </ul>
                    <p class="emergency-note">@L["Emergency_Dan_Note"]</p>
                </div>
            </div>

            @if (site.ContentLevel == 0)
            {
                <div class="callout directory-only" data-content-level="0">
                    <h3>@L["DirectoryOnly_Title"]</h3>
                    <p>@L["DirectoryOnly"] <a href="@PublicRoutes.Contact(Language, site.Name)">@L["DirectoryOnly_Write"]</a></p>
                </div>
            }

            <p class="site-links">
                <a href="@PublicRoutes.DiveSiteVersions(Language, site.Slug)">@L["Link_Versions"]</a>
                <a href="@PublicRoutes.DiveSiteEdit(Language, site.Slug)" rel="nofollow" data-enhance-nav="false">@L["Link_Edit"]</a>
            </p>
        </section>
        break;

    case DiveSiteLookup.Gone:
        <PageTitle>@L["Gone_Title"] · @Shared["Brand"]</PageTitle>
        <HeadContent>
            <meta name="robots" content="noindex" />
        </HeadContent>
        <h1 class="status-title">@L["Gone_Title"]</h1>
        <p>@L["Gone_Text"]</p>
        break;
}

@code {
    /// <summary>Rückmeldung nach dem Speichern im Bearbeiten-Modus: `vorschlag` oder `online`.</summary>
    [SupplyParameterFromQuery(Name = "gespeichert")]
    public string? Saved { get; set; }

    private DiveSiteLookup? lookup;

    private SiteForecast? forecast;

    [Parameter]
    public string Slug { get; set; } = "";

    [CascadingParameter]
    public HttpContext? HttpContext { get; set; }

    private static string Language => CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;

    protected override async Task OnInitializedAsync()
    {
        lookup = await DiveSites.Handle(new GetDiveSiteQuery(Slug, Language));

        switch (lookup)
        {
            case DiveSiteLookup.Found found:
                forecast = await Forecasts.Handle(new GetSiteForecastQuery(found.Site.Id));
                break;
            case DiveSiteLookup.Moved moved:
                RedirectPermanently(PublicRoutes.DiveSite(Language, moved.Slug));
                break;
            case DiveSiteLookup.Gone:
                SetStatusCode(StatusCodes.Status410Gone);
                break;
            case DiveSiteLookup.NotFound:
                Navigation.NotFound();
                break;
        }
    }

    private void RedirectPermanently(string location)
    {
        SetStatusCode(StatusCodes.Status301MovedPermanently);
        HttpContext?.Response.Headers.Location = location;
    }

    private void SetStatusCode(int statusCode)
    {
        if (HttpContext is not null)
        {
            HttpContext.Response.StatusCode = statusCode;
        }
    }

    private static string MapLink(DiveSiteDetails site) =>
        string.Create(CultureInfo.InvariantCulture, $"https://map.geo.admin.ch/?lang={Language}&swisssearch={site.Latitude:0.0000},{site.Longitude:0.0000}");

    private static string GoogleRoute(DiveSiteDetails site) =>
        string.Create(CultureInfo.InvariantCulture, $"https://www.google.com/maps/dir/?api=1&destination={site.Latitude:0.00000},{site.Longitude:0.00000}");

    private static string AppleRoute(DiveSiteDetails site) =>
        string.Create(CultureInfo.InvariantCulture, $"https://maps.apple.com/?daddr={site.Latitude:0.00000},{site.Longitude:0.00000}&dirflg=d");

    private static string Coordinates(DiveSiteDetails site) =>
        $"{site.Latitude.ToString("0.0000", CultureInfo.CurrentCulture)}° N, {site.Longitude.ToString("0.0000", CultureInfo.CurrentCulture)}° E";
}
