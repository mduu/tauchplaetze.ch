@using Tauchplaetze.Core.Features.DiveSites
@inject IStringLocalizer<DiveSiteStrings> L

<details class="symbol-legend" data-symbol-legend>
    <summary>@L["Symbols_Legend"]</summary>
    <ul>
        <li><SiteSymbolBar Decorative="true" Symbols="Sample(NoticeKind.Closure, null, null)" /><span>@L["Notice_Closure"]</span></li>
        <li><SiteSymbolBar Decorative="true" Symbols="Sample(NoticeKind.Warning, null, null)" /><span>@L["Notice_Warning"]</span></li>
        @foreach (var band in Enum.GetValues<DifficultyBand>())
        {
            <li><SiteSymbolBar Decorative="true" Symbols="Sample(null, band, null)" /><span>@L["Symbol_Difficulty_Title", L[$"Symbol_Difficulty_{band}"]]</span></li>
        }
        <li><SiteSymbolBar Decorative="true" Symbols="Sample(null, null, 42)" /><span>@L["Symbol_Depth_Title", 42]</span></li>
        @foreach (var symbol in Enum.GetValues<SiteSymbol>())
        {
            <li><SiteSymbolBar Decorative="true" Symbols="new SiteSymbols(null, null, null, null, [symbol])" /><span>@L[$"Symbol_{symbol}"]</span></li>
        }
    </ul>
</details>

@code {
    private static SiteSymbols Sample(NoticeKind? notice, DifficultyBand? difficulty, int? depth) => new(notice, difficulty, depth, null, []);
}
