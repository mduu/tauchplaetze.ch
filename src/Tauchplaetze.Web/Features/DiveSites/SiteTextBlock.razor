@using Tauchplaetze.Core.Features.DiveSites
@inject IStringLocalizer<DiveSiteStrings> L

@if (Text is not null)
{
    <div class="site-text" data-text="@Name">
        @if (Title is not null)
        {
            <h3 class="site-text-title">@Title</h3>
        }
        @if (Text.OnlyGerman)
        {
            <p class="site-text-note">@L["Text_OnlyGerman"]</p>
        }
        else if (Text.MachineTranslated)
        {
            <p class="site-text-note">@L["Text_MachineTranslated"]</p>
        }
        <div class="site-text-body" lang="@(Text.OnlyGerman ? "de" : null)">@((MarkupString)SiteTextMarkup.ToHtml(Text.Text))</div>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public SiteText? Text { get; set; }

    [Parameter, EditorRequired]
    public string Name { get; set; } = "";

    [Parameter]
    public string? Title { get; set; }
}
