@page "/de/tauchplaetze/{Slug}/bearbeiten"
@page "/en/dive-sites/{Slug}/edit"
@page "/fr/sites-de-plongee/{Slug}/modifier"
@page "/it/siti-di-immersione/{Slug}/modifica"
@attribute [Authorize]
@inherits AdminPage
@using Microsoft.AspNetCore.Authorization
@using Tauchplaetze.Core.Features.DiveSites
@using Tauchplaetze.Core.Features.DiveSites.Queries
@using Tauchplaetze.Core.Features.Editorial
@using Tauchplaetze.Core.Features.Editorial.Commands
@using Tauchplaetze.Core.Features.Editorial.Queries
@using Tauchplaetze.Core.Features.WaterBodies
@using Tauchplaetze.Web.Features.Editorial
@inject IStringLocalizer<DiveSiteStrings> Site
@inject IStringLocalizer<SharedStrings> Shared
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ILogger<EditDiveSitePage> Logger

<PageTitle>@Site["EditMode_Title", details?.Name ?? ""] · @Shared["Brand"]</PageTitle>
<HeadContent>
    <meta name="robots" content="noindex" />
</HeadContent>

@if (gone)
{
    <section class="page-section">
        <h1 class="status-title">@Site["Gone_Title"]</h1>
        <p>@Site["Gone_Text"]</p>
    </section>
}
else if (details is null || form is null || editing is null)
{
}
else
{
    <div class="edit-mode" data-edit-mode data-edit-dirty="@(IsDirty ? "true" : "false")">
        <div class="edit-bar" role="region" aria-label="@Site["EditMode_Label"]">
            <p class="edit-bar-text">
                <strong>@Site["EditMode_Label"]</strong>
                <span>· @(IsModerator ? Site["EditMode_Bar_Moderator"] : Site["EditMode_Bar_Contributor"])</span>
            </p>
            <div class="edit-bar-actions">
                <a class="button secondary" href="@PublicRoutes.DiveSite(Language, details.Slug)">@Site["EditMode_Cancel"]</a>
                <button type="button" class="button" disabled="@saving" @onclick="Save">
                    @(saving ? Site["EditMode_Saving"] : IsModerator ? Site["EditMode_Submit_Moderator"] : Site["EditMode_Submit_Contributor"])
                </button>
            </div>
        </div>

        <header class="edit-container edit-head">
            <p class="eyebrow">@details.WaterBodyName</p>
            <h1 class="page-title">@Site["EditMode_Title", details.Name]</h1>
        </header>

        <div class="edit-container">
        @if (openProposal is { } open)
        {
            <p class="callout" data-open-proposal>
                @L["Edit_OpenProposal", SwissClock.DateTime(open.SubmittedAt)]
                <a href="@AccountPaths.Proposals(Language)">@L["Edit_OpenProposal_Link"]</a>
            </p>
        }

        @if (HasErrors || message is not null)
        {
            <div class="message @(HasErrors ? "error" : "ok")" role="@(HasErrors ? "alert" : "status")" tabindex="-1" @ref="messageBox">
                @foreach (var error in errors)
                {
                    <p>@L[$"Error_{error}"]</p>
                }
                @if (saveFailed)
                {
                    <p>@L["Edit_SaveFailed"]</p>
                }
                @if (message is not null)
                {
                    <p>@message</p>
                }
            </div>
        }
        </div>

        <section class="page-section edit-section" aria-labelledby="edit-basics">
            <h2 id="edit-basics" class="edit-section-title">@Site["EditMode_Section_Basics"]</h2>
            <div class="edit-grid">
                <FormText Label="@L["Field_Name"]" @bind-Value="form.Name" MaxLength="120" Required="true" />
                <FormText Label="@L["Field_OtherNames"]" @bind-Value="form.OtherNames" Help="@L["Field_OtherNames_Help"]" MaxLength="450" />
                <FormText Label="@L["Field_Municipality"]" @bind-Value="form.Municipality" MaxLength="80" />
                <FormText Label="@L["Field_Canton"]" @bind-Value="form.Canton" MaxLength="2" />
            </div>
            <p class="field-help">@L["Field_WaterBodyId"]: @details.WaterBodyName · @Site["EditMode_WaterBody_Help"]</p>
            <LocationField Id="edit-site-location" Label="@L["Field_Location"]" Help="@Site["EditMode_Location_Help"]"
                           Latitude="form.Latitude" Longitude="form.Longitude" Changed="Locate" />
        </section>

        <section class="page-section edit-section" aria-labelledby="edit-notices" data-edit-notices>
            <h2 id="edit-notices" class="edit-section-title">@Site["Notices_Label"]</h2>
            <SiteNoticeEditor Form="form" Changed="StateHasChanged" />
        </section>

        <section class="page-section edit-section" aria-labelledby="edit-site">
            <h2 id="edit-site" class="edit-section-title">@Site["Ratings_Title"]</h2>
            <div class="edit-grid">
                <FormNumber Label="@L["Field_MaxDepth"]" @bind-Value="form.MaxDepth" Min="1" Max="300" Unit="m" />
                <FormSelect TValue="DiveSiteAccess?" Label="@L["Field_Access"]" @bind-Value="form.Access" EmptyLabel="@L["Rating_None"]"
                            Options="@([.. Enum.GetValues<DiveSiteAccess>().Select(a => ((DiveSiteAccess?)a, L[$"Access_{a}"].Value))])" />
            </div>
            <fieldset class="chips-field">
                <legend class="field-label">@L["Field_Features"]</legend>
                <div class="chips">
                    @foreach (var feature in SiteForm.AllFeatures)
                    {
                        var current = feature;
                        <FormChip Label="@L[$"Feature_{current}"]" Checked="form.Features.Contains(current)" CheckedChanged="@(on => Toggle(current, on))" />
                    }
                </div>
            </fieldset>
            <div class="level-grid">
                @foreach (var field in SiteForm.RatingFields)
                {
                    var current = field;
                    var scale = field.Replace("Rating", "");
                    <LevelPicker Label="@Site[$"Rating_{scale}"]" Value="form.Ratings.GetValueOrDefault(current)" ValueChanged="@(value => form.Ratings[current] = value)"
                                 Legend="Legend(scale)" NoneLabel="@L["Rating_None"]" InfoLabel="@Site["Rating_Info", Site[$"Rating_{scale}"]]"
                                 IsLevel="@(scale is "Difficulty" or "Current")" />
                }
            </div>
        </section>

        <section class="page-section edit-section" aria-labelledby="edit-texts">
            <h2 id="edit-texts" class="edit-section-title">@Site["EditMode_Section_Texts"]</h2>
            <p class="field-help">@L["Field_Markdown_Help"]</p>
            <LanguageTabs Label="@Site["EditMode_Section_Texts"]" @bind-Selected="textLanguage">
                <div class="edit-texts">
                    <SiteTextTranslator Form="form" Target="@context" Changed="StateHasChanged" />
                    <FormTextArea Label="@L["Field_UnderwaterDescription"]" @bind-Value="form.Texts[context].UnderwaterDescription" Preview="SiteTextMarkup.ToHtml" PreviewLabel="@L["Field_Markdown_Preview"]" Rows="6" />
                    <FormTextArea Label="@L["Field_HazardsInfo"]" @bind-Value="form.Texts[context].HazardsInfo" Preview="SiteTextMarkup.ToHtml" PreviewLabel="@L["Field_Markdown_Preview"]" MaxLength="2000" />
                    <FormTextArea Label="@L["Field_ApproachInfo"]" @bind-Value="form.Texts[context].ApproachInfo" Preview="SiteTextMarkup.ToHtml" PreviewLabel="@L["Field_Markdown_Preview"]" MaxLength="2000" />
                    <FormTextArea Label="@L["Field_SurroundingsInfo"]" @bind-Value="form.Texts[context].SurroundingsInfo" Preview="SiteTextMarkup.ToHtml" PreviewLabel="@L["Field_Markdown_Preview"]" MaxLength="2000" />
                    <FormTextArea Label="@L["Field_FacilitiesInfo"]" @bind-Value="form.Texts[context].FacilitiesInfo" Preview="SiteTextMarkup.ToHtml" PreviewLabel="@L["Field_Markdown_Preview"]" Rows="2" MaxLength="1000" />
                </div>
            </LanguageTabs>
        </section>

        <section class="page-section edit-section" aria-labelledby="edit-map">
            <h2 id="edit-map" class="edit-section-title">@Site["Location_Title_EntryPoints"]</h2>
            <SiteMapEditor Id="edit-site-map" Form="form" Changed="StateHasChanged" />
        </section>

        <section class="page-section edit-section" aria-labelledby="edit-photos">
            <h2 id="edit-photos" class="edit-section-title">@Site["Photos_Title"]</h2>
            @if (errors.Contains(EditorialError.InvalidMedia))
            {
                <p class="field-error" role="alert">@L["Error_InvalidMedia"]</p>
            }
            <SitePhotoEditor SiteId="details.Id" Form="form" Changed="StateHasChanged" />
        </section>

        @if (IsModerator && details.WaterBodyType == WaterBodyType.River)
        {
            <section class="page-section edit-section" aria-labelledby="edit-moderation" data-edit-moderation>
                <h2 id="edit-moderation" class="edit-section-title">@L["Edit_Tab_Moderation"] · @L["Field_Discharge"]</h2>
                <div class="edit-grid">
                    <FormDecimal Label="@L["Field_DischargeLowFrom"]" @bind-Value="form.DischargeLowFrom" Unit="m³/s" />
                    <FormDecimal Label="@L["Field_DischargeMediumFrom"]" @bind-Value="form.DischargeMediumFrom" Unit="m³/s" />
                    <FormDecimal Label="@L["Field_DischargeStrongFrom"]" @bind-Value="form.DischargeStrongFrom" Unit="m³/s" />
                </div>
                <p class="field-help">@L["Field_Discharge_Help"]</p>
            </section>
        }

        <section class="page-section edit-section" aria-labelledby="edit-comment">
            <h2 id="edit-comment" class="edit-section-title">@Site["EditMode_Section_Comment"]</h2>
            <FormTextArea Label="@Site["EditMode_Comment"]" @bind-Value="form.Comment" Rows="2" MaxLength="500" Help="@Site["EditMode_Comment_Help"]" />
        </section>
    </div>
}

@code {
    private DiveSiteDetails? details;

    private DiveSiteForEditing? editing;

    private SiteForm? form;

    private MyProposal? openProposal;

    private IReadOnlyList<EditorialError> errors = [];

    private string? message;

    private string textLanguage = Language;

    private bool saving;

    private bool saveFailed;

    private bool gone;

    private string? savedContent;

    private ElementReference messageBox;

    private bool focusMessage;

    [CascadingParameter]
    public HttpContext? HttpContext { get; set; }

    [Parameter]
    public string Slug { get; set; } = "";

    protected override async Task Load()
    {
        switch (await Query<GetDiveSiteQuery, DiveSiteLookup>(new GetDiveSiteQuery(Slug, Language)))
        {
            case DiveSiteLookup.Found found:
                details = found.Site;
                editing = await Query<GetDiveSiteForEditingQuery, DiveSiteForEditing?>(new GetDiveSiteForEditingQuery(found.Site.Id));
                form = editing is null ? null : SiteForm.From(editing.Content);
                savedContent = form is null ? null : Serialized(form);
                openProposal = (await Query<GetMyProposalsQuery, IReadOnlyList<MyProposal>>(new GetMyProposalsQuery(UserId, found.Site.Id, PendingOnly: true))).FirstOrDefault();
                if (editing is null)
                {
                    Navigation.NotFound();
                }

                break;
            case DiveSiteLookup.Moved moved:
                Navigation.NavigateTo(PublicRoutes.DiveSiteEdit(Language, moved.Slug), forceLoad: true);
                break;
            case DiveSiteLookup.Gone:
                gone = true;
                if (HttpContext is not null)
                {
                    HttpContext.Response.StatusCode = StatusCodes.Status410Gone;
                }

                break;
            default:
                Navigation.NotFound();
                break;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusMessage)
        {
            focusMessage = false;
            await messageBox.FocusAsync();
        }
    }

    private bool HasErrors => errors.Count > 0 || saveFailed;

    /// <remarks>Steuert die Warnung beim Verlassen (`site.js`). Vergleicht den Inhalt des Formulars mit dem geladenen.</remarks>
    private bool IsDirty => form is not null && savedContent is not null && Serialized(form) != savedContent;

    private static string Serialized(SiteForm form) => System.Text.Json.JsonSerializer.Serialize(new { Content = form.ToContent(), form.Comment });


    private IReadOnlyList<(string Short, string Text)> Legend(string scale) =>
        [.. Enumerable.Range(1, 5).Select(step => (Site[$"Rating_{scale}_{step}"].Value, Site[$"Rating_{scale}_{step}_Text"].Value))];

    private void Locate((double Latitude, double Longitude) point) => (form!.Latitude, form.Longitude) = point;

    private void Toggle(DiveSiteFeatures feature, bool on)
    {
        if (on)
        {
            form!.Features.Add(feature);
        }
        else
        {
            form!.Features.Remove(feature);
        }
    }

    private async Task Save()
    {
        if (saving)
        {
            return;
        }

        saving = true;
        message = null;
        saveFailed = false;
        EditorialResult result;
        try
        {
            result = await Command<ProposeChangeCommand, EditorialResult>(new ProposeChangeCommand(UserId, details!.Id, editing!.BaseNumber, form!.ToContent(), form.Comment));
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Saving dive site {DiveSiteId} failed", details!.Id);
            errors = [];
            saveFailed = true;
            focusMessage = true;
            return;
        }
        finally
        {
            saving = false;
        }

        errors = result.Errors;
        focusMessage = errors.Count > 0;
        if (result is { Succeeded: true, NoChange: true })
        {
            message = Site["EditMode_NoChange"];
        }
        else if (result.Succeeded)
        {
            savedContent = Serialized(form);
            await JS.InvokeVoidAsync("tauchplaetzeEdit.saved");
            var saved = result.Status == RevisionStatus.Approved ? "online" : "vorschlag";
            Navigation.NavigateTo($"{PublicRoutes.DiveSite(Language, details.Slug)}?gespeichert={saved}", forceLoad: true);
        }
    }
}
