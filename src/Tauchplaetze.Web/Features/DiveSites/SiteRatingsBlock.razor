@using Tauchplaetze.Core.Features.DiveSites
@inject IStringLocalizer<DiveSiteStrings> L

@if (Rated.Count > 0)
{
    <section class="page-section" aria-labelledby="ratings">
        <h2 id="ratings" class="ratings-title">@L["Ratings_Title"]</h2>
        <ul class="ratings">
            @foreach (var (scale, value, isLevel) in Rated)
            {
                var legendId = $"rating-legend-{scale.ToLowerInvariant()}";
                <li class="rating" data-rating="@scale">
                    <div class="rating-head">
                        <span class="rating-name">@L[$"Rating_{scale}"]</span>
                        <button type="button" class="rating-info" popovertarget="@legendId" data-hover-popover
                                aria-label="@L["Rating_Info", L[$"Rating_{scale}"]]"><span aria-hidden="true">i</span></button>
                    </div>
                    <div class="rating-scale" data-kind="@(isLevel ? "level" : "quality")" role="img" aria-label="@L["Rating_Value", value]">
                        @for (var step = 1; step <= 5; step++)
                        {
                            <span class="rating-step" data-on="@(step <= value ? "true" : "false")"></span>
                        }
                    </div>
                    <div class="rating-value"><span class="rating-number">@value</span> @L[$"Rating_{scale}_{value}"]</div>

                    <div id="@legendId" popover class="rating-legend">
                        <p class="rating-legend-title">@L[$"Rating_{scale}"]</p>
                        <ol>
                            @for (var step = 1; step <= 5; step++)
                            {
                                <li aria-current="@(step == value ? "true" : null)">
                                    <span class="rating-legend-number">@step</span>
                                    <span><strong>@L[$"Rating_{scale}_{step}"]</strong> · @L[$"Rating_{scale}_{step}_Text"]</span>
                                </li>
                            }
                        </ol>
                    </div>
                </li>
            }
        </ul>
    </section>
}

@code {
    [Parameter, EditorRequired]
    public SiteRatings? Ratings { get; set; }

    /// <summary>Nur bewertete Skalen. Schwierigkeit und Strömung sind Stufen, die übrigen Qualitäten (`dive-site.md`, «Bewertungen»).</summary>
    private List<(string Scale, byte Value, bool IsLevel)> Rated => Ratings is not { } r
        ? []
        : new (string Scale, byte? Value, bool IsLevel)[]
            {
                ("Difficulty", r.Difficulty, true),
                ("Wall", r.Wall, false),
                ("MarineLife", r.MarineLife, false),
                ("Wrecks", r.Wrecks, false),
                ("Current", r.Current, true),
                ("Surroundings", r.Surroundings, false),
            }
            .Where(s => s.Value is >= 1 and <= 5)
            .Select(s => (s.Scale, s.Value!.Value, s.IsLevel))
            .ToList();
}
