@using Tauchplaetze.Core.Features.Media
@inject IStringLocalizer<DiveSiteStrings> L

@if (Photos.Count > 0)
{
    <section class="page-section" aria-labelledby="photos">
        <h2 id="photos" class="photos-title">@L["Photos_Title"]</h2>
        <div class="photos">
            @foreach (var photo in Photos.OrderBy(p => p.Section))
            {
                <figure class="photo">
                    <a href="@photo.Renditions[^1].Url" target="_blank" rel="noopener" data-lightbox>
                        <img src="@Rendition(photo, 960)" srcset="@PhotoMarkup.SrcSet(photo.Renditions)" sizes="(min-width: 960px) 20vw, (min-width: 520px) 45vw, 90vw"
                             width="@photo.Width" height="@photo.Height" loading="lazy" decoding="async" alt="@(photo.AltText ?? photo.Caption ?? "")" />
                    </a>
                    <figcaption>
                        <span class="photo-section">@L[$"PhotoSection_{photo.Section}"]</span>
                        @if (photo.Caption is not null)
                        {
                            <span class="photo-caption">@photo.Caption</span>
                        }
                        <span class="photo-credit">
                            @if (photo.PhotographerUrl is not null)
                            {
                                <a href="@photo.PhotographerUrl" rel="noopener nofollow" target="_blank">@L["Photo_Credit", photo.Photographer]</a>
                            }
                            else
                            {
                                @L["Photo_Credit", photo.Photographer]
                            }
                            @if (photo.Depth is { } depth)
                            {
                                <text> · @L["Photo_Depth", depth]</text>
                            }
                        </span>
                    </figcaption>
                </figure>
            }
        </div>
        <dialog class="lightbox" data-lightbox-dialog tabindex="-1" aria-label="@L["Photos_Title"]">
            <figure class="lightbox-figure">
                <img class="lightbox-image" alt="" />
                <figcaption class="lightbox-caption"></figcaption>
            </figure>
            <span class="lightbox-count" aria-live="polite"></span>
            <button type="button" class="lightbox-button lightbox-close" data-lightbox-close autofocus aria-label="@L["Lightbox_Close"]">✕</button>
            <button type="button" class="lightbox-button lightbox-previous" data-lightbox-previous aria-label="@L["Lightbox_Previous"]">‹</button>
            <button type="button" class="lightbox-button lightbox-next" data-lightbox-next aria-label="@L["Lightbox_Next"]">›</button>
        </dialog>
    </section>
}

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<PublicPhoto> Photos { get; set; } = [];

    private static string Rendition(PublicPhoto photo, int width) =>
        (photo.Renditions.FirstOrDefault(r => r.Width >= width) ?? photo.Renditions[^1]).Url;
}
