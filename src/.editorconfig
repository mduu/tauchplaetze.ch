root = true

[*.cs]

dotnet_diagnostic.IDE0005.severity = warning

csharp_prefer_braces = true:warning
dotnet_diagnostic.IDE0011.severity = warning

dotnet_diagnostic.IDE1006.severity = warning

dotnet_naming_symbols.constant_fields.applicable_kinds = field
dotnet_naming_symbols.constant_fields.applicable_accessibilities = *
dotnet_naming_symbols.constant_fields.required_modifiers = const

dotnet_naming_symbols.private_static_fields.applicable_kinds = field
dotnet_naming_symbols.private_static_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_static_fields.required_modifiers = static

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private

dotnet_naming_style.pascal_case.capitalization = pascal_case
dotnet_naming_style.camel_case.capitalization = camel_case

dotnet_naming_rule.constant_fields_are_pascal_case.symbols = constant_fields
dotnet_naming_rule.constant_fields_are_pascal_case.style = pascal_case
dotnet_naming_rule.constant_fields_are_pascal_case.severity = warning

dotnet_naming_rule.private_static_fields_are_pascal_case.symbols = private_static_fields
dotnet_naming_rule.private_static_fields_are_pascal_case.style = pascal_case
dotnet_naming_rule.private_static_fields_are_pascal_case.severity = warning

dotnet_naming_rule.private_fields_are_camel_case.symbols = private_fields
dotnet_naming_rule.private_fields_are_camel_case.style = camel_case
dotnet_naming_rule.private_fields_are_camel_case.severity = warning

[**/Migrations/*.cs]
generated_code = true
dotnet_diagnostic.IDE0005.severity = none
dotnet_diagnostic.IDE0011.severity = none
dotnet_diagnostic.IDE1006.severity = none
