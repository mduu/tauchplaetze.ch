<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Daten: EF Core, SQL Server, Geodaten, Identity">
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer.NetTopologySuite" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.13" />
    <!-- Transitiv über Microsoft.Data.SqlClient. 10.0.12 hat bekannte Lücken (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7). -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup Label="CMS">
    <PackageVersion Include="MudBlazor" Version="9.7.0" />
  </ItemGroup>

  <ItemGroup Label="Fotos: Bildgrössen (MIT) und EXIF (Apache-2.0), ADR-009">
    <PackageVersion Include="SkiaSharp" Version="4.153.1" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.153.1" />
    <PackageVersion Include="MetadataExtractor" Version="2.9.3" />
  </ItemGroup>

  <ItemGroup Label="Mail und Identity">
    <PackageVersion Include="MailKit" Version="4.18.1" />
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup Label="Betrieb in Azure: Entra-Anmeldung an SQL, Application Insights">
    <!-- Ab SqlClient 7 liegt die Anmeldung mit Entra (`Authentication=Active Directory Default`) in diesem Paket. Version wie SqlClient. -->
    <PackageVersion Include="Microsoft.Data.SqlClient.Extensions.Azure" Version="7.0.2" />
    <PackageVersion Include="Azure.Monitor.OpenTelemetry.AspNetCore" Version="1.5.0" />
  </ItemGroup>

  <ItemGroup Label="Maschinelle Übersetzung (Claude API)">
    <PackageVersion Include="Anthropic" Version="12.55.0" />
  </ItemGroup>

  <ItemGroup Label="Aspire">
    <PackageVersion Include="Aspire.Hosting.SqlServer" Version="13.6.1" />
    <PackageVersion Include="Aspire.Hosting.Azure.Storage" Version="13.6.1" />
    <PackageVersion Include="Aspire.Microsoft.EntityFrameworkCore.SqlServer" Version="13.6.1" />
    <PackageVersion Include="Aspire.Azure.Storage.Blobs" Version="13.6.1" />
    <PackageVersion Include="Aspire.Azure.Storage.Queues" Version="13.6.1" />
    <!-- Aspire 13.6.1 bringt MessagePack 2.5.302 mit (GHSA-qhrr-8q5h-9q3h). Die korrigierte Version festhalten. -->
    <PackageVersion Include="MessagePack" Version="2.5.307" />
  </ItemGroup>

  <ItemGroup Label="Betrieb: Resilience, Service Discovery, OpenTelemetry">
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.11.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.0" />
  </ItemGroup>

  <ItemGroup Label="Test">
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.15.0" />
    <PackageVersion Include="Mono.Cecil" Version="0.11.6" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
  </ItemGroup>

  <ItemGroup Label="Nur Spike 0.5 (src/spikes)">
    <PackageVersion Include="Shouldly" Version="4.3.0" />
  </ItemGroup>

</Project>
